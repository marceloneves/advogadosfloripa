---
import { site, activeSocials, waLink, hoursFull } from '../data/site';
---

<div class="fix-area">
	<div class="offcanvas__info">
		<div class="offcanvas__wrapper">
			<div class="offcanvas__content">
				<div class="offcanvas__top mb-5 d-flex justify-content-between align-items-center">
					<div class="offcanvas__logo">
						<a class="kfs-logo" href="/" aria-label={`${site.name} — página inicial`}>
							<img
							src="/theme/img/brand/kfs-logo-nomes-280.webp"
							srcset="/theme/img/brand/kfs-logo-nomes-280.webp 280w, /theme/img/brand/kfs-logo-nomes-480.webp 480w, /theme/img/brand/kfs-logo-nomes-960.webp 960w"
							sizes="132px"
							alt={site.legalName}
							width="480"
							height="323"
							/>
						</a>
					</div>
					<div class="offcanvas__close">
						<button aria-label="Fechar menu">
							<i class="fas fa-times" aria-hidden="true"></i>
						</button>
					</div>
				</div>

				<p class="text d-none d-lg-block">
					Advocacia em Florianópolis com atuação em Direito Criminal, Civil, Militar, da Saúde, do Trabalho, Previdenciário e Administrativo.
				</p>

				<div class="mobile-menu fix mb-3"></div>

				<div class="offcanvas__contact">
					<p class="offcanvas__contact-title">Informações de contato</p>
					<ul>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fal fa-map-marker-alt" aria-hidden="true"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a target="_blank" rel="noopener" href={`https://www.google.com/maps/search/${encodeURIComponent(site.address)}`}>
									{site.addressShort}
								</a>
							</div>
						</li>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fal fa-envelope" aria-hidden="true"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a href={`mailto:${site.email}`}>{site.email}</a>
							</div>
						</li>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fal fa-clock" aria-hidden="true"></i>
							</div>
							<div class="offcanvas__contact-text">
								<span>{hoursFull}</span>
							</div>
						</li>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fal fa-phone" aria-hidden="true"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a href={`tel:+${site.whatsapp}`}>{site.phone}</a>
							</div>
						</li>
					</ul>

					<div class="header-button mt-4">
						<a href={waLink('Olá! Gostaria de agendar uma consulta.')} target="_blank" rel="noopener" class="theme-btn text-center">
							<span>
								Agendar consulta
								<i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
							</span>
						</a>
					</div>

					<div class="social-icon d-flex align-items-center">
						{activeSocials.map((s) => (
							<a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>
								<i class={s.icon}></i>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

---
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';

interface Props {
  formId?: string;
}

const { formId = 'contact-form' } = Astro.props;

const details = [
  {
    icon: 'fa-solid fa-location-dot',
    label: 'Endereço',
    value: site.address,
    href: `https://www.google.com/maps/search/${encodeURIComponent(site.address)}`,
    external: true,
  },
  {
    icon: 'fa-solid fa-phone',
    label: 'Telefone / WhatsApp',
    value: site.phone,
    href: `tel:+${site.whatsapp}`,
  },
  {
    icon: 'fa-solid fa-envelope',
    label: 'E-mail',
    value: site.email,
    href: `mailto:${site.email}`,
  },
  { icon: 'fa-solid fa-clock', label: 'Horário', value: site.hours },
];
---

<section class="contact-section section-padding fix section-bg">
	<div class="container">
		<div class="row g-5 align-items-center">
			<div class="col-lg-5">
				<div class="section-title">
					<span class="sub-title wow fadeInUp">Contato</span>
					<h2 class="wow fadeInUp" data-wow-delay=".3s">Estamos no Centro de Florianópolis</h2>
				</div>
				<p class="wow fadeInUp" data-wow-delay=".5s">
					Atendemos presencialmente na Grande Florianópolis e por videoconferência para todo o
					Brasil.
				</p>

				<ul class="contact-details wow fadeInUp" data-wow-delay=".7s">
					{details.map((d) => (
						<li class="contact-detail-item">
							<div class="icon">
								<i class={d.icon}></i>
							</div>
							<div class="content">
								<h5>{d.label}</h5>
								{d.href ? (
									<a
										href={d.href}
										target={d.external ? '_blank' : undefined}
										rel={d.external ? 'noopener' : undefined}
									>
										{d.value}
									</a>
								) : (
									<span>{d.value}</span>
								)}
							</div>
						</li>
					))}
				</ul>
			</div>

			<div class="col-lg-7">
				<ContactForm id={formId} boxed />
			</div>
		</div>
	</div>
</section>

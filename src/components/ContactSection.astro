---
import ContactForm from './ContactForm.astro';
import { site, hoursFull } from '../data/site';

interface Props {
  formId?: string;
  /** Set to false to render without the WOW.js reveal animations. */
  animate?: boolean;
}

const { formId = 'contact-form', animate = true } = Astro.props;

const details = [
  {
    icon: 'fa-solid fa-location-dot',
    label: 'Endereço',
    value: site.address,
    href: `https://www.google.com/maps/search/${encodeURIComponent(site.address)}`,
    external: true,
  },
  {
    icon: 'fa-solid fa-phone',
    label: 'Telefone / WhatsApp',
    value: site.phone,
    href: `tel:+${site.whatsapp}`,
  },
  {
    icon: 'fa-solid fa-envelope',
    label: 'E-mail',
    value: site.email,
    href: `mailto:${site.email}`,
  },
  { icon: 'fa-solid fa-clock', label: 'Horário', value: hoursFull },
];
---

<section class="contact-section section-padding fix section-bg" aria-label="Contato">
	<div class="container">
		<div class="row g-5 align-items-center">
			<div class="col-lg-5">
				<div class="section-title">
					<span class:list={['sub-title', animate && 'wow fadeInUp']}>Contato</span>
					<h2 class:list={[animate && 'wow fadeInUp']} data-wow-delay={animate ? '.3s' : undefined}>Estamos no Centro de Florianópolis</h2>
				</div>
				<p class:list={[animate && 'wow fadeInUp']} data-wow-delay={animate ? '.5s' : undefined}>
					Atendemos presencialmente na Grande Florianópolis e por videoconferência para todo o
					Brasil.
				</p>

				<ul class:list={['contact-details', animate && 'wow fadeInUp']} data-wow-delay={animate ? '.7s' : undefined}>
					{details.map((d) => (
						<li class="contact-detail-item">
							<div class="icon">
								<i class={d.icon}></i>
							</div>
							<div class="content">
								<h3>{d.label}</h3>
								{d.href ? (
									<a
										href={d.href}
										target={d.external ? '_blank' : undefined}
										rel={d.external ? 'noopener' : undefined}
									>
										{d.value}
									</a>
								) : (
									<span>{d.value}</span>
								)}
							</div>
						</li>
					))}
				</ul>
			</div>

			<div class="col-lg-7">
				<ContactForm id={formId} boxed animate={animate} />
			</div>
		</div>
	</div>
</section>

---
interface Props {
  heading: string;
  crumbs?: { label: string; href?: string }[];
  /** Set to false to render without the WOW.js reveal animations. */
  animate?: boolean;
}

const { heading, crumbs = [], animate = true } = Astro.props;
---

{/* Sem .kfs-pattern aqui: o fundo agora é a foto do escritório, e o grafismo
    da ponte por cima dela lia como uma segunda imagem sobreposta. O pattern
    segue nas seções de cor chapada (CTA da home). */}
<section class="breadcrumb-wrapper fix kfs-pattern-bg" aria-label="Cabeçalho da página">
	<div class="container">
		<div class="row">
			<div class="page-heading">
				<div class="breadcrumb-sub-title">
					<h1 class:list={[animate && 'wow fadeInUp']} data-wow-delay={animate ? '.3s' : undefined}>{heading}</h1>
				</div>
				<nav aria-label="Trilha de navegação">
				<ul class:list={['breadcrumb-list', animate && 'wow fadeInUp']} data-wow-delay={animate ? '.5s' : undefined}>
					<li><a href="/">Início</a></li>
					{crumbs.map((c) => (
						<li>
							<i class="fa-sharp fa-solid fa-slash-forward" aria-hidden="true"></i>
							{c.href ? <a href={c.href}>{c.label}</a> : c.label}
						</li>
					))}
				</ul>
				</nav>
			</div>
		</div>
	</div>
</section>

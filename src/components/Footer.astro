---
import { site, socials, services } from '../data/site';

interface Props {
  /** Set to false to render without the WOW.js reveal animations. */
  animate?: boolean;
}

const { animate = true } = Astro.props;

const wow = (delay: string, base = '') => ({
  class: [base, animate && 'wow fadeInUp'].filter(Boolean).join(' ') || undefined,
  'data-wow-delay': animate ? delay : undefined,
});

const year = new Date().getFullYear();

const legalLinks = [
  { label: 'Política de Privacidade', href: '/politica-de-privacidade' },
  { label: 'Política de Cookies', href: '/politica-de-cookies' },
  { label: 'Termos de Uso', href: '/termos-de-uso' },
];

const quickLinks = [
  { label: 'Quem Somos', href: '/quem-somos' },
  { label: 'Advogados', href: '/escritorio' },
  { label: 'Nossa Atuação', href: '/atuacao' },
  { label: 'Depoimentos', href: '/depoimentos' },
  { label: 'Perguntas Frequentes', href: '/faq' },
  { label: 'Blog', href: '/blog' },
];
---

<footer>
	<section class="footer-section fix">
		<div class="container">
			<div class="footer-widget-wrapper">
				<div class="row">
					<div {...wow('.2s', 'col-xl-4 col-sm-6 col-md-6 col-lg-4')}>
						<div class="single-footer-widget">
							<div class="widget-head">
								<a href="/" class="kfs-logo" aria-label={`${site.name} — página inicial`}>
									<img src="/theme/img/brand/kfs-logo-branco.svg" alt={site.name} width="910" height="267" />
								</a>
							</div>
							<div class="footer-content">
								<p>
									Escritório de advocacia no Centro de Florianópolis, com atuação em Direito
									Criminal, Civil, Militar, da Saúde, do Trabalho, Previdenciário e
										Administrativo.
								</p>
								<div class="social-icon">
									{socials.map((s) => (
										<a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>
											<i class={s.icon}></i>
										</a>
									))}
								</div>
							</div>
						</div>
					</div>

					<div {...wow('.4s', 'col-xl-3 col-sm-6 col-md-6 col-lg-4 ps-lg-5')}>
						<div class="single-footer-widget">
							<div class="widget-head">
								<h4>Escritório</h4>
							</div>
							<ul class="list-items">
								{quickLinks.map((l) => (
									<li>
										<a href={l.href}>{l.label}</a>
									</li>
								))}
							</ul>
						</div>
					</div>

					<div {...wow('.6s', 'col-xl-2 col-sm-6 col-md-6 col-lg-4')}>
						<div class="single-footer-widget">
							<div class="widget-head">
								<h4>Áreas</h4>
							</div>
							<ul class="list-items">
								{services.map((s) => (
									<li>
										<a href={`/servicos#${s.slug}`}>{s.title}</a>
									</li>
								))}
							</ul>
						</div>
					</div>

					<div {...wow('.8s', 'col-xl-3 col-sm-6 col-md-6 col-lg-4 ps-xl-5')}>
						<div class="single-footer-widget">
							<div class="widget-head">
								<h4>Contato</h4>
							</div>
							<div class="contact-info">
								<h6>{site.address}</h6>
								<h6>
									<a href={`tel:+${site.whatsapp}`}>{site.phone}</a>
								</h6>
								<h6>
									<a href={`mailto:${site.email}`}>{site.email}</a>
								</h6>
								<h6>{site.hours}</h6>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="footer-bottom">
				<div class="container">
					<div class="footer-wrapper">
						<p {...wow('.3s')}>
							© {year} {site.legalName} — CNPJ {site.cnpj}. Todos os direitos reservados.
						</p>
						<ul class="bottom-list">
							{legalLinks.map((l) => (
								<li><a href={l.href}>{l.label}</a></li>
							))}
						</ul>
					</div>
					<p class="kfs-credit">
						Site criado e mantido por{' '}
						<a href="https://pmturbo.com/" target="_blank" rel="noopener">PMTurbo</a>
					</p>
				</div>
			</div>
		</div>
	</section>
</footer>

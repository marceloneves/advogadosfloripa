---
import { waLink } from '../data/site';

interface Props {
  title?: string;
  /** Texto do botão. */
  cta?: string;
}

const {
  title = 'Solicite uma avaliação do seu caso',
  cta = 'Falar com um advogado',
} = Astro.props;
---

{/* Faixa baixa: frase em uma linha, fundo Azul Oceano chapado, botão ao lado. */}
<section class="kfs-cta-band" aria-label="Chamada para contato">
	<div class="container">
		<div class="kfs-cta-inner">
			<h2>{title}</h2>
			<a
				href={waLink('Olá! Gostaria de uma avaliação do meu caso.')}
				target="_blank"
				rel="noopener"
				class="theme-btn"
			>
				{cta}
				<i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
			</a>
		</div>
	</div>
</section>

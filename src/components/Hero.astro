---
import { waLink } from '../data/site';
---

{/*
  O tema empilha três imagens no hero: o fundo, um retrato sobreposto à direita
  (.hero-image) e um recorte decorativo no meio do <h1>. As duas sobreposições
  vieram da demo e foram removidas — sobra o fundo, com o gradiente em Azul
  Oceano do tema garantindo a leitura do texto.
*/}
<section class="hero-section hero-2 fix bg-cover kfs-hero">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-lg-9">
				<div class="hero-content">
					<span>Advocacia em Florianópolis</span>
					<h1 class="wow fadeInUp" data-wow-delay=".3s">
						Defesa séria e comprometida com seus direitos
					</h1>
					<p class="wow fadeInUp" data-wow-delay=".5s">
						Escritório no Centro de Florianópolis com atuação em Direito Criminal, Militar, da
						Saúde, Previdenciário, Administrativo e Civil. Atendimento próximo, ético e orientado
						a resultados.
					</p>
					<div class="hero-button wow fadeInUp" data-wow-delay=".7s">
						<a href={waLink('Olá! Gostaria de agendar uma consulta.')} target="_blank" rel="noopener" class="theme-btn">
							Agendar consulta
							<i class="fa-solid fa-arrow-right-long"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

---
import { site, nav, activeSocials, waLink } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="header-section-1">
	<!-- Top bar -->
	<div class="header-top-section">
		<div class="container">
			<div class="header-top-wrapper">
				<ul class="top-left">
					<li>
						<i class="fa-solid fa-location-dot" aria-hidden="true"></i>
						<a
							href={`https://www.google.com/maps/search/${encodeURIComponent(site.address)}`}
							target="_blank"
							rel="noopener"
							class="link">{site.addressShort}</a
						>
					</li>
					<li>
						<i class="fa-solid fa-envelope" aria-hidden="true"></i>
						<a href={`mailto:${site.email}`} class="link">{site.email}</a>
					</li>
				</ul>
				<div class="top-right">
					<div class="social-icon">
						{activeSocials.map((s) => (
							<a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>
								<i class={s.icon}></i>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Main header -->
	<div id="header-sticky" class="header-1" data-sticky="true">
		<div class="main-logo">
			<a href="/" class="kfs-logo" aria-label={`${site.name} — página inicial`}>
				<img
				src="/theme/img/brand/kfs-logo-nomes-480.webp"
				srcset="/theme/img/brand/kfs-logo-nomes-480.webp 480w, /theme/img/brand/kfs-logo-nomes-960.webp 960w"
				sizes="240px"
				alt={site.legalName}
				width="480"
				height="323"
							/>
			</a>
		</div>

		<div class="countact-call">
			<div class="icon">
				<i class="fa-solid fa-phone" aria-hidden="true"></i>
			</div>
			<div class="content">
				<span>Fale conosco</span>
				<p class="header-phone">
					<a href={`tel:+${site.whatsapp}`}>{site.phone}</a>
				</p>
			</div>
		</div>

		<div class="container">
			<div class="mega-menu-wrapper">
				<div class="header-main">
					<div class="logo d-none">
						<a href="/" class="kfs-logo" aria-label={`${site.name} — página inicial`}>
							<img
							src="/theme/img/brand/kfs-logo-nomes-480.webp"
							srcset="/theme/img/brand/kfs-logo-nomes-480.webp 480w, /theme/img/brand/kfs-logo-nomes-960.webp 960w"
							sizes="240px"
							alt={site.legalName}
							width="480"
							height="323"
							/>
						</a>
					</div>

					<nav class="mean__menu-wrapper" aria-label="Menu principal">
						<div class="main-menu">
							<div id="mobile-menu">
								<ul>
									{nav.map((item) => (
										<li
											class:list={[
												item.children && 'has-dropdown',
												isActive(item.href) && 'current-menu-item active',
											]}
										>
											<a href={item.href}>{item.label}</a>
											{item.children && (
												<ul class="sub-menu">
													{item.children.map((c) => (
														<li>
															<a href={c.href}>{c.label}</a>
														</li>
													))}
												</ul>
											)}
										</li>
									))}
								</ul>
							</div>
						</div>
					</nav>

					<div class="header-right d-flex justify-content-end align-items-center">
						<button type="button" class="search-trigger search-icon" aria-label="Buscar">
							<i class="fa-regular fa-magnifying-glass" aria-hidden="true"></i>
						</button>

						<a
							href={waLink('Olá! Gostaria de agendar uma consulta.')}
							target="_blank"
							rel="noopener"
							class="theme-btn style-2"
						>
							Agendar consulta
							<i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i>
						</a>

						<div class="header__hamburger d-xl-none my-auto">
							<div class="sidebar__toggle">
								<i class="fas fa-bars" aria-hidden="true"></i>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

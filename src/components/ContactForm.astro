---
import { site } from '../data/site';
import { services } from '../data/site';

interface Props {
  id?: string;
  /** Wrap the fields in the theme's boxed appointment card. */
  boxed?: boolean;
  sub?: string;
  title?: string;
  /** Set to false to render without the WOW.js reveal animations. */
  animate?: boolean;
}

const {
  id = 'contact-form',
  boxed = false,
  sub = 'Agende um atendimento',
  title = 'Conte o seu caso',
  animate = true,
} = Astro.props;

const wow = (delay: string, base = '') => ({
  class: [base, animate && 'wow fadeInUp'].filter(Boolean).join(' ') || undefined,
  'data-wow-delay': animate ? delay : undefined,
});
---

<div class:list={[boxed && 'appointment-wrapper']}>
	<div class:list={[boxed && 'contact-content']}>
		{boxed && (
			<>
				<span {...wow('.3s')}>{sub}</span>
				<h3 {...wow('.5s')}>{title}</h3>
			</>
		)}

		<form id={id} class="contact-form-items" novalidate>
			<div class="row g-4">
				<div {...wow('.3s', 'col-lg-6')}>
					<div class="form-clt">
						<label class="sr-only" for={`${id}-nome`}>Seu nome</label>
						<input
							type="text"
							id={`${id}-nome`}
							name="nome"
							placeholder="Seu nome"
							autocomplete="name"
							required
							aria-required="true"
						/>
					</div>
				</div>
				<div {...wow('.5s', 'col-lg-6')}>
					<div class="form-clt">
						<label class="sr-only" for={`${id}-email`}>Seu e-mail</label>
						<input
							type="email"
							id={`${id}-email`}
							name="email"
							placeholder="Seu e-mail"
							autocomplete="email"
							required
							aria-required="true"
						/>
					</div>
				</div>
				<div {...wow('.3s', 'col-lg-6')}>
					<div class="form-clt">
						<label class="sr-only" for={`${id}-telefone`}>Telefone ou WhatsApp</label>
						<input
							type="tel"
							id={`${id}-telefone`}
							name="telefone"
							placeholder="Telefone / WhatsApp"
							autocomplete="tel"
							inputmode="tel"
						/>
					</div>
				</div>
				<div {...wow('.5s', 'col-lg-6')}>
					<div class="form-clt">
						<label class="sr-only" for={`${id}-area`}>Área do direito</label>
						<select id={`${id}-area`} name="area">
							<option value="">Área do direito</option>
							{services.map((s) => (
								<option value={s.title}>{s.title}</option>
							))}
							<option value="Outra">Outra</option>
						</select>
					</div>
				</div>
				<div {...wow('.3s', 'col-lg-12')}>
					<div class="form-clt">
						<label class="sr-only" for={`${id}-mensagem`}>Descreva brevemente o seu caso</label>
						<textarea
							id={`${id}-mensagem`}
							name="mensagem"
							rows="5"
							placeholder="Descreva brevemente o seu caso"
							required
							aria-required="true"
						></textarea>
					</div>
				</div>
				<div class="col-lg-12">
					<p id={`${id}-erro`} class="kfs-form-error" role="alert" aria-live="polite" hidden></p>
				</div>
				<div {...wow('.5s', 'col-lg-12')}>
					<button type="submit" class="theme-btn">
						Enviar pelo WhatsApp
						<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
					</button>
				</div>
			</div>
		</form>
	</div>
</div>

<script is:inline define:vars={{ id, whatsapp: site.whatsapp }}>
	document.getElementById(id)?.addEventListener('submit', (e) => {
		e.preventDefault();
		const f = e.target;
		const get = (n) => (f.elements[n]?.value || '').trim();
		const erro = document.getElementById(id + '-erro');

		const faltando = ['nome', 'email', 'mensagem'].filter((n) => !get(n));
		if (faltando.length) {
			erro.textContent = 'Preencha nome, e-mail e mensagem para enviar.';
			erro.hidden = false;
			const campo = f.elements[faltando[0]];
			campo?.setAttribute('aria-invalid', 'true');
			campo?.focus();
			return;
		}

		erro.hidden = true;
		['nome', 'email', 'mensagem'].forEach((n) => f.elements[n]?.removeAttribute('aria-invalid'));

		const linhas = [
			`Olá! Meu nome é ${get('nome')}.`,
			get('area') && `Área: ${get('area')}`,
			`E-mail: ${get('email')}`,
			get('telefone') && `Telefone: ${get('telefone')}`,
			'',
			get('mensagem'),
		].filter(Boolean);

		window.open(
			`https://wa.me/${whatsapp}?text=${encodeURIComponent(linhas.join('\n'))}`,
			'_blank',
			'noopener'
		);
	});
</script>

---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  columns?: string;
}

const { posts, columns = 'col-xl-4 col-lg-6' } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="row g-4">
	{posts.map((post) => (
		<div class={`${columns} col-md-6 wow fadeInUp`} data-wow-delay=".3s">
			<div class="news-card-items-2 h-100">
				<div class="news-image">
					<img src={post.data.image} alt={post.data.title} />
				</div>
				<div class="news-content">
					<ul class="post-meta mb-3">
						<li>{fmt(post.data.date)}</li>
						<li>{post.data.category}</li>
					</ul>
					<h4>
						<a href={`/blog/${post.id}`}>{post.data.title}</a>
					</h4>
					<a href={`/blog/${post.id}`} class="link-btns">
						Ler artigo <i class="fa-solid fa-arrow-right"></i>
					</a>
				</div>
			</div>
		</div>
	))}
</div>

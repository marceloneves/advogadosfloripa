---
import Layout from '../layouts/Layout.astro';
import WorkProcess from '../components/WorkProcess.astro';
import Testimonials from '../components/Testimonials.astro';
import HistorySlider from '../components/HistorySlider.astro';
import ConsultationCta from '../components/ConsultationCta.astro';
import Counters from '../components/Counters.astro';
import ArrayButton from '../components/ArrayButton.astro';
import { values } from '../data/content';
import { waLink } from '../data/site';
---

<Layout
	title="Quem Somos — KFS Sociedade de Advogados"
	description="Conheça o escritório KFS: trajetória, valores e a equipe de advogados que atua em Florianópolis."
	heading="Quem Somos"
	crumbs={[{ label: 'Quem Somos' }]}
	animate={false}
>
	<!-- História -->
	<section class="about-section section-padding fix">
		<div class="container">
			<div class="row g-4 align-items-center">
				<div class="col-lg-6">
					<div class="about-wrapper-2">
						<div class="about-image">
							<img
								class="wow img-custom-anim-left"
								data-wow-duration="1.3s"
								data-wow-delay="0.3s"
								src="/theme/img/equipe/equipe-kfs-900.webp"
								srcset="/theme/img/equipe/equipe-kfs-600.webp 600w, /theme/img/equipe/equipe-kfs-900.webp 900w, /theme/img/equipe/equipe-kfs-1200.webp 1200w"
								sizes="(max-width: 991px) 100vw, 560px"
								width="900"
								height="675"
								alt="Os advogados Fernando Fabre, Matheus Stein e Asterley Kincezski no escritório KFS, em Florianópolis"
							/>
						</div>
					</div>
				</div>

				<div class="col-lg-6">
					<div class="about-content">
						<div class="section-title">
							<span class="sub-title wow fadeInUp">O escritório</span>
							<h2 class="wow fadeInUp" data-wow-delay=".3s">
								Advogados experientes, prontos para ajudar
							</h2>
						</div>
						<p class="wow fadeInUp" data-wow-delay=".5s">
							O <strong>KFS</strong> nasceu do encontro de profissionais com
							trajetórias complementares: Ministério Público, Forças Armadas e Administração
							Pública de Santa Catarina. Essa bagagem sustenta uma advocacia que entende o
							processo por dentro.
						</p>
						<p class="wow fadeInUp" data-wow-delay=".6s">
							Atuamos em Direito Criminal, Civil, Militar, da Saúde, do Trabalho, Previdenciário e Administrativo, sempre com o mesmo compromisso: explicar o caso em português claro,
							apresentar os cenários possíveis e conduzir com transparência do início ao fim.
						</p>

						<div class="counter-items wow fadeInUp" data-wow-delay=".7s">
							<div class="content">
								<h5>+20</h5>
								<p>Anos de experiência somada</p>
							</div>
							<div class="content">
								<h5>+1.500</h5>
								<p>Casos atendidos</p>
							</div>
						</div>

						<div class="about-button wow fadeInUp" data-wow-delay=".9s">
							<a href={waLink('Olá! Gostaria de conhecer o escritório.')} target="_blank" rel="noopener" class="theme-btn">
								Falar com o escritório
								<i class="fa-brands fa-whatsapp"></i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Valores -->
	<section class="feature-section section-padding fix section-bg">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Nossos valores</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">O que orienta o nosso trabalho</h2>
			</div>
			<div class="row g-4">
				{values.map((v) => (
					<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay=".3s">
						<div class="service-box-items h-100">
							<div class="service-content">
								<div class="icon mb-3">
									<i class={v.icon}></i>
								</div>
								<h4>{v.title}</h4>
								<p>{v.text}</p>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Processo -->
	<section class="process-section section-padding fix">
		<div class="container">
			<div class="row g-4 align-items-center">
				<div class="col-lg-5">
					<div class="section-title">
						<span class="sub-title wow fadeInUp">Como trabalhamos</span>
						<h2 class="wow fadeInUp" data-wow-delay=".3s">Nosso processo, passo a passo</h2>
					</div>
					<p class="wow fadeInUp" data-wow-delay=".5s">
						Sem etapas escondidas. Você sabe o que vai acontecer antes de acontecer.
					</p>
					<div class="mt-4 wow fadeInUp" data-wow-delay=".7s">
						<img src="/theme/img/demo/01-3.jpg" alt="Atendimento no escritório" class="img-fluid" />
					</div>
				</div>
				<div class="col-lg-7">
					<WorkProcess variant="style1" />
				</div>
			</div>
		</div>
	</section>

	<!-- Números -->
	<section class="counter-section fix pb-5">
		<div class="container">
			<Counters />
		</div>
	</section>

	<!-- Trajetória -->
	<section class="work-process-section section-padding fix section-bg">
		<div class="container">
			<div class="section-title-area mb-5">
				<div class="section-title">
					<span class="sub-title wow fadeInUp">Nossa trajetória</span>
					<h2 class="wow fadeInUp" data-wow-delay=".3s">Experiência construída ao longo do tempo</h2>
				</div>
				<ArrayButton variant="style-2" />
			</div>
			<HistorySlider />
		</div>
	</section>

	<!-- Depoimentos -->
	<section class="testimonial-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Depoimentos</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Resultados que falam por nós</h2>
			</div>
			<Testimonials />
		</div>
	</section>

	<ConsultationCta />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import ConsultationCta from '../../components/ConsultationCta.astro';
import ContactSection from '../../components/ContactSection.astro';
import Accordion from '../../components/Accordion.astro';
import { services, waLink } from '../../data/site';
import { servicoContent } from '../../data/servicos';
import { getLawyer } from '../../data/team';

export function getStaticPaths() {
  return services.flatMap((area) =>
    (area.topics ?? []).map((topic) => ({
      params: { slug: topic.slug },
      props: { area, topic },
    }))
  );
}

const { area, topic } = Astro.props;
const content = servicoContent[topic.slug];

const origin = (Astro.site ?? new URL('https://kfsadvogados.com.br')).origin;

/** Autoria: YMYL jurídico exige responsável identificável e data de revisão. */
const responsavel = area.lawyer ? getLawyer(area.lawyer) : undefined;
const revisadoEm = '2026-08-06';
const revisadoLabel = '6 de agosto de 2026';

/** Google corta a description por volta de 160 caracteres. */
/** Google trunca o title por volta de 60 caracteres. */
const TITLE_SUF = ' | KFS Advogados';
const pageTitle =
  `${topic.title} em Florianópolis`.length + TITLE_SUF.length <= 60
    ? `${topic.title} em Florianópolis${TITLE_SUF}`
    : `${topic.title}${TITLE_SUF}`;

const SUFIXO = ' Advogados em Florianópolis/SC.';
const metaDescription =
  (topic.text.length + SUFIXO.length <= 160
    ? topic.text
    : `${topic.text.slice(0, 157 - SUFIXO.length).trimEnd()}…`) + SUFIXO;

/**
 * FAQPage não gera mais rich result no Google (retirado em maio/2026), mas
 * segue sendo lido por assistentes de IA ao citar a página — por isso fica.
 */
const schema = [
  {
    '@type': 'Service',
    name: `${topic.title} em Florianópolis`,
    description: topic.text,
    serviceType: topic.title,
    category: area.title,
    provider: { '@id': `${origin}/#escritorio` },
    areaServed: { '@type': 'City', name: 'Florianópolis' },
    ...(responsavel
      ? {
          review: undefined,
          termsOfService: `${origin}/termos-de-uso`,
        }
      : {}),
  },
  ...(responsavel
    ? [
        {
          '@type': 'WebPage',
          url: `${origin}/servicos/${topic.slug}`,
          name: `${topic.title} em Florianópolis`,
          dateModified: revisadoEm,
          about: { '@id': `${origin}/#escritorio` },
          reviewedBy: {
            '@type': 'Attorney',
            name: responsavel.name,
            url: `${origin}/escritorio/${responsavel.slug}`,
            ...(responsavel.oab ? { identifier: responsavel.oab } : {}),
          },
        },
      ]
    : []),
  ...(content?.faqs?.length
    ? [
        {
          '@type': 'FAQPage',
          mainEntity: content.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];

/** Demais serviços da mesma área, para navegação lateral. */
const siblings = (area.topics ?? []).filter((t) => t.slug !== topic.slug);
---

<Layout
	title={pageTitle}
	description={metaDescription}
	heading={`${topic.title} em Florianópolis`}
	crumbs={[{ label: 'Áreas de Atuação', href: '/servicos' }, { label: topic.title }]}
	schema={schema}
	animate={false}
>
	<section class="service-section section-padding fix kfs-service-page">
		<div class="container">
			<div class="row g-5">
				<div class="col-lg-8">
					<div class="section-title">
						<span class="sub-title">{area.title}</span>
						<h2>O que é {topic.title.toLowerCase()}</h2>
					</div>
					{content?.oQueE.map((p) => <p class="mb-3">{p}</p>)}

					<div class="section-title mt-5">
						<h2>Como funciona</h2>
					</div>
					<ul class="about-list">
						{content?.comoFunciona.map((step) => (
							<li>
								<i class="fa-solid fa-check"></i>
								{step}
							</li>
						))}
					</ul>

					<div class="section-title mt-5">
						<h2>Por que contar com um advogado</h2>
					</div>
					{content?.porQue.map((p) => <p class="mb-3">{p}</p>)}

					{responsavel && (
						<div class="kfs-authorship">
							<p>
								Conteúdo sob responsabilidade de{' '}
								<a href={`/escritorio/${responsavel.slug}`}>{responsavel.name}</a>
								{responsavel.oab ? `, ${responsavel.oab}` : ''} — {responsavel.role}.
							</p>
							<p class="kfs-authorship-date">
								Última revisão em {revisadoLabel}. Conteúdo informativo: não substitui a análise
								do seu caso por um advogado.
							</p>
						</div>
					)}

					{content?.faqs?.length ? (
						<>
							<div class="section-title mt-5">
								<h2>Perguntas frequentes</h2>
							</div>
							<Accordion id={`faq-${topic.slug}`} items={content.faqs} />
						</>
					) : null}
				</div>

				<div class="col-lg-4">
					<div class="service-box-items">
						<div class="service-content">
							<h4>Fale sobre o seu caso</h4>
							<p>
								Conte o que aconteceu e retornamos com os caminhos possíveis. Atendimento
								presencial em Florianópolis e por videoconferência.
							</p>
							<a
								href={waLink(`Olá! Gostaria de falar sobre ${topic.title}.`)}
								target="_blank"
								rel="noopener"
								class="theme-btn mt-3"
							>
								Falar com um advogado
								<i class="fa-brands fa-whatsapp"></i>
							</a>
						</div>
					</div>

					{siblings.length > 0 && (
						<div class="service-box-items mt-4">
							<div class="service-content">
								<h4>Em {area.title}</h4>
								<ul class="about-list mt-3">
									{siblings.map((t) => (
										<li>
											<i class="fa-solid fa-check"></i>
											<a href={`/servicos/${t.slug}`}>{t.title}</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					)}
				</div>
			</div>
		</div>
	</section>

	<ConsultationCta title={`Precisa de orientação sobre ${topic.title.toLowerCase()}?`} />

	<ContactSection formId={`${topic.slug}-contact`} animate={false} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import ConsultationCta from '../components/ConsultationCta.astro';
import ArrayButton from '../components/ArrayButton.astro';
import { testimonials } from '../data/content';

const stars = (n: number) =>
  Array.from({ length: 5 }, (_, i) => (i < n ? 'fas fa-star' : 'far fa-star'));
---

<Layout
	title="Depoimentos — KFS Sociedade de Advogados"
	description="O que dizem os clientes do escritório KFS sobre atendimento, transparência e resultados."
	heading="Depoimentos"
	crumbs={[{ label: 'Depoimentos' }]}
>
	<!-- Slider -->
	<section class="testimonial-section section-padding fix">
		<div class="container">
			<div class="section-title-area mb-5">
				<div class="section-title">
					<span class="sub-title wow fadeInUp">Depoimentos</span>
					<h2 class="wow fadeInUp" data-wow-delay=".3s">Quem já foi atendido por nós</h2>
				</div>
				<ArrayButton />
			</div>
			<Testimonials />
		</div>
	</section>

	<!-- Grade completa -->
	<section class="testimonial-section section-padding fix section-bg pt-0">
		<div class="container">
			<div class="row g-4">
				{testimonials.map((t) => (
					<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay=".3s">
						<div class="Testimonial-box-items h-100">
							<div class="star mb-3">
								{stars(t.rating).map((c) => (
									<i class={c}></i>
								))}
							</div>
							<p>{t.text}</p>
							<div class="client-info-items mt-4">
								<div class="client-info">
									<div class="client-img">
										<img src={t.image} alt={t.name} />
									</div>
									<div class="client-content">
										<h4>{t.name}</h4>
										<span>{t.role}</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<ConsultationCta
		sub="Sua vez"
		title="Vamos conversar sobre o seu caso"
		text="Atendemos com o mesmo cuidado que gerou esses depoimentos. Conte a sua situação sem compromisso."
	/>
</Layout>

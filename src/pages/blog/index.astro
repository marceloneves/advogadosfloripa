---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogGrid from '../../components/BlogGrid.astro';
import ConsultationCta from '../../components/ConsultationCta.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
	title="Blog — KFS Sociedade de Advogados"
	description="Artigos sobre Direito Criminal, Civil, Militar, Previdenciário e Administrativo escritos pelos advogados do escritório."
	heading="Blog"
	crumbs={[{ label: 'Blog' }]}
	animate={false}
>
	<section class="news-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Artigos</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Orientação jurídica em linguagem clara</h2>
			</div>

			{posts.length > 0 ? (
				<BlogGrid posts={posts} />
			) : (
				<p class="text-center">Nenhum artigo publicado ainda.</p>
			)}
		</div>
	</section>

	<ConsultationCta />
</Layout>

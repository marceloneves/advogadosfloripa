---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import WorkProcess from '../components/WorkProcess.astro';
import ConsultationCta from '../components/ConsultationCta.astro';
---

<Layout
	title="Nossa Atuação — KFS Sociedade de Advogados"
	description="Tipos de demanda que o escritório KFS atende em Florianópolis: saúde, criminal, militar, previdenciário, administrativo e civil."
	heading="Nossa Atuação"
	crumbs={[{ label: 'Nossa Atuação' }]}
>
	<section class="project-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Demandas que atendemos</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Situações que chegam ao escritório</h2>
			</div>
			<ProjectGrid />
			<p class="text-center mt-5">
				<small>
					As situações acima descrevem tipos de demanda atendidos pelo escritório. Cada caso é
					analisado individualmente e resultados anteriores não garantem resultados futuros.
				</small>
			</p>
		</div>
	</section>

	<section class="feature-section section-padding fix section-bg">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Como conduzimos</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Do primeiro contato à conclusão</h2>
			</div>
			<WorkProcess variant="style2" limit={3} />
		</div>
	</section>

	<ConsultationCta />
</Layout>

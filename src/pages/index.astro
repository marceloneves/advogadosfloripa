---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import WorkProcess from '../components/WorkProcess.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Accordion from '../components/Accordion.astro';
import ContactSection from '../components/ContactSection.astro';
import ConsultationCta from '../components/ConsultationCta.astro';
import Counters from '../components/Counters.astro';
---

<Layout
	title="KFS Sociedade de Advogados — Advocacia em Florianópolis"
	description="Advocacia no Centro de Florianópolis: Direito Criminal, Civil, Militar, Saúde, Trabalho, Previdenciário e Administrativo."
	animate={false}
>
	<Hero />

	<!-- Números -->
	<section class="counter-section fix section-padding pb-0">
		<div class="container">
			<Counters />
		</div>
	</section>

	<AboutSection />

	<!-- Áreas de atuação -->
	<section class="service-section section-padding fix section-bg">
		<div class="container">
			<div class="section-title-area mb-5">
				<div class="section-title">
					<span class="sub-title wow fadeInUp">Áreas de atuação</span>
					<h2 class="wow fadeInUp" data-wow-delay=".3s">
						Onde podemos ajudar você
					</h2>
				</div>
				<p class="wow fadeInUp" data-wow-delay=".5s">
					Atuação multidisciplinar para pessoas físicas,<br /> servidores públicos e empresas.
				</p>
			</div>
			<ServiceGrid variant="style2" />
		</div>
	</section>

	<!-- Como trabalhamos -->
	<section class="feature-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Como trabalhamos</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Do primeiro contato à decisão final</h2>
			</div>
			<WorkProcess variant="style2" limit={3} />
		</div>
	</section>

	<!-- Advogados -->
	<section class="team-section section-padding fix section-bg">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Nossa equipe</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Advogados dedicados ao seu caso</h2>
			</div>
			<TeamGrid variant="style1" />
		</div>
	</section>

	<!-- FAQ -->
	<section class="faq-section section-padding fix section-bg">
		<div class="container">
			<div class="row g-4 align-items-center">
				<div class="col-lg-5">
					<div class="section-title">
						<span class="sub-title wow fadeInUp">Dúvidas frequentes</span>
						<h2 class="wow fadeInUp" data-wow-delay=".3s">Perguntas que sempre nos fazem</h2>
					</div>
					<p class="wow fadeInUp" data-wow-delay=".5s">
						Não encontrou o que procurava? Fale conosco — respondemos sem compromisso.
					</p>
					<div class="mt-4 wow fadeInUp" data-wow-delay=".7s">
						<a href="/faq" class="theme-btn">
							Ver todas as perguntas
							<i class="fa-solid fa-arrow-right"></i>
						</a>
					</div>
				</div>
				<div class="col-lg-7">
					<Accordion limit={4} />
				</div>
			</div>
		</div>
	</section>

	<ContactSection formId="home-contact" />

	<ConsultationCta />
</Layout>

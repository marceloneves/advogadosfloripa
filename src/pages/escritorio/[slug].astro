---
import Layout from '../../layouts/Layout.astro';
import ConsultationCta from '../../components/ConsultationCta.astro';
import LawyerPhoto from '../../components/LawyerPhoto.astro';
import { team } from '../../data/team';
import { waLink } from '../../data/site';

export function getStaticPaths() {
  return team.map((lawyer) => ({
    params: { slug: lawyer.slug },
    props: { lawyer },
  }));
}

const { lawyer } = Astro.props;

const origin = (Astro.site ?? new URL('https://kfsadvogados.com.br')).origin;

const schema = [
  {
    '@type': 'Attorney',
    name: lawyer.name,
    jobTitle: lawyer.role,
    description: lawyer.bio,
    image: `${origin}${lawyer.photo}`,
    url: `${origin}/escritorio/${lawyer.slug}`,
    ...(lawyer.oab ? { identifier: lawyer.oab } : {}),
    knowsAbout: lawyer.areas,
    knowsLanguage: 'pt-BR',
    worksFor: { '@id': `${origin}/#escritorio` },
    areaServed: { '@type': 'City', name: 'Florianópolis' },
  },
];
---

<Layout
	title={`${lawyer.shortName} — Advogado em Florianópolis | KFS`}
	description={`${lawyer.name}${lawyer.oab ? `, ${lawyer.oab}` : ''}. Advogado em Florianópolis com atuação em ${lawyer.areas.slice(0, 3).join(', ')}.`}
	heading={lawyer.name}
	crumbs={[{ label: 'Advogados', href: '/escritorio' }, { label: lawyer.shortName }]}
	ogImage={lawyer.photo}
	schema={schema}
	animate={false}
>
	<!-- Perfil -->
	<section class="team-details-section section-padding fix">
		<div class="container">
			<div class="row g-4">
				<div class="col-lg-5">
					<div class="profile-photo">
						<LawyerPhoto
							lawyer={lawyer}
							variant="profile"
							loading="eager"
							class="wow img-custom-anim-left"
						/>
					</div>

					<div class="single-footer-widget mt-4">
						<div class="widget-head">
							<h4>Dados profissionais</h4>
						</div>
						<ul class="about-list">
							{lawyer.oab && (
								<li>
									<i class="fa-solid fa-id-badge"></i>
									{lawyer.oab}
								</li>
							)}
							{lawyer.city && (
								<li>
									<i class="fa-solid fa-location-dot"></i>
									{lawyer.city}
								</li>
							)}
							{lawyer.birth && (
								<li>
									<i class="fa-solid fa-cake-candles"></i>
									{lawyer.birth}
								</li>
							)}
							{lawyer.status && (
								<li>
									<i class="fa-solid fa-ring"></i>
									{lawyer.status}
								</li>
							)}
						</ul>

						<div class="mt-4">
							<a
								href={waLink(`Olá! Gostaria de falar com ${lawyer.shortName}.`)}
								target="_blank"
								rel="noopener"
								class="theme-btn"
							>
								Falar com {lawyer.shortName}
								<i class="fa-solid fa-arrow-right"></i>
							</a>
						</div>
					</div>
				</div>

				<div class="col-lg-7">
					<div class="section-title">
						<span class="sub-title wow fadeInUp">{lawyer.role}</span>
						<h2 class="wow fadeInUp" data-wow-delay=".3s">{lawyer.name}</h2>
					</div>
					<p class="wow fadeInUp" data-wow-delay=".5s">{lawyer.bio}</p>

					<h4 class="mt-5 mb-3">Áreas de atuação</h4>
					<div class="profile-tags wow fadeInUp" data-wow-delay=".6s">
						{lawyer.areas.map((a) => (
							<span>{a}</span>
						))}
					</div>

					{lawyer.roles && (
						<>
							<h4 class="mt-5 mb-3">Atuação institucional</h4>
							<ul class="about-list">
								{lawyer.roles.map((r) => (
									<li>
										<i class="fa-solid fa-check"></i>
										{r}
									</li>
								))}
							</ul>
						</>
					)}

					{lawyer.highlights && (
						<>
							<h4 class="mt-5 mb-3">Destaques</h4>
							<ul class="about-list">
								{lawyer.highlights.map((h) => (
									<li>
										<i class="fa-solid fa-star"></i>
										{h}
									</li>
								))}
							</ul>
						</>
					)}
				</div>
			</div>
		</div>
	</section>

	<!-- Experiência -->
	<section class="process-section section-padding fix section-bg">
		<div class="container">
			<div class="section-title mb-5">
				<span class="sub-title wow fadeInUp">Trajetória</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Experiência profissional</h2>
			</div>

			<div class="process-wrapper">
				<div class="process-content ms-0">
					<div class="process-ber">
						<div class="line-shape">
							<img src="/theme/img/demo/line-shape.png" alt="" loading="lazy" decoding="async" />
						</div>
						{lawyer.experience.map((e, i) => (
							<div class="process-items wow fadeInUp" data-wow-delay=".2s">
								<h6 class="number">{e.period ?? String(i + 1).padStart(2, '0')}</h6>
								<div class="content">
									{e.title && <h3>{e.title}</h3>}
									<p>{e.detail}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Formação -->
	<section class="service-section section-padding fix">
		<div class="container">
			<div class="section-title mb-5">
				<span class="sub-title wow fadeInUp">Formação</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Formação acadêmica</h2>
			</div>
			<div class="row g-4">
				{lawyer.education.map((e) => (
					<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay=".3s">
						<div class="service-box-items h-100">
							<div class="service-content">
								<span class="sub-title">{e.period}</span>
								<h4 class="mt-2">{e.title}</h4>
								<p>{e.org}</p>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<ConsultationCta sub="Atendimento" title={lawyer.cta.title} text={lawyer.cta.text} />
</Layout>

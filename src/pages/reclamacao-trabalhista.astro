						<div class="field">
							<label for="lp-fase">Como está a sua situação</label>
							<select id="lp-fase" name="fase">
								<option value="">Selecione</option>
								<option>Fui demitido e as verbas não foram pagas</option>
								<option>Pedi demissão ou quero pedir</option>
								<option>Ainda estou trabalhando na empresa</option>
								<option>Trabalhei sem registro ou como PJ</option>
								<option>Sofri assédio ou acidente de trabalho</option>
								<option>Outra situação</option>
							</select>
						</div>
						<div class="field">
							<label for="lp-mensagem">Como foi o seu trabalho</label>
							<textarea id="lp-mensagem" name="mensagem" rows="5" required></textarea>
						</div>
						<p id="lp-erro" class="form-error" role="alert" aria-live="polite" hidden></p>
						<button type="submit" class="btn btn-primary btn-block">Falar com Dr. Asterley</button>

---
/**
 * Landing page autônoma da reclamação trabalhista (lado do trabalhador): não
 * usa o Layout do tema (Header, Footer, Bootstrap, jQuery). Mesma estrutura e
 * mesmo CSS da landing da Lei Maria da Penha.
 *
 * Publicidade dentro do Código de Ética e do Provimento 205/2021 da OAB:
 * sem promessa de resultado, sem preço, sem depoimento de cliente, sem
 * mercantilização. Tom informativo e sóbrio.
 */
import Schema from '../components/Schema.astro';
import { site, waLink } from '../data/site';
import { getLawyer } from '../data/team';

const advogado = getLawyer('asterley-kincezski');

const origin = (Astro.site ?? new URL('https://kfsadvogados.com.br')).origin;
const canonical = `${origin}/reclamacao-trabalhista`;

const title = 'Reclamação Trabalhista — Defesa do Colaborador | KFS Advogados';
const description =
  'Reclamação trabalhista em Florianópolis pelo lado do trabalhador: verbas rescisórias, horas extras, reconhecimento de vínculo, rescisão indireta, assédio e estabilidade.';

/**
 * A bio de team.ts está em terceira pessoa e é usada nas páginas do escritório.
 * Esta landing fala na voz do próprio advogado, então tem a sua própria versão.
 */
const bioPrimeiraPessoa =
  'Sou advogado inscrito na OAB/SC 18.119, com mais de duas décadas de trajetória no Direito Civil, no Direito Público e no Direito do Trabalho. Sou servidor da Secretaria de Estado da Administração de Santa Catarina, onde atuo como Gerente de Processos Institucionais da Diretoria do Plano de Saúde do Servidor (SC Saúde), e membro da Comissão de Direito da Saúde da OAB/SC. Nesses anos reuni experiência em assessoria jurídica institucional, administração pública e na discussão judicial de direitos de trabalhadores e servidores.';

/** Sem o número em team.ts, a inscrição fica marcada até ser preenchida. */
const oabAdvogado = 'OAB/SC nº [INSERIR NÚMERO OAB]';

const revisadoEm = '2026-08-11';
const revisadoLabel = '11 de agosto de 2026';

/** Mensagem inicial do WhatsApp: já chega com contexto para a triagem. */
const waTexto = 'Olá! Preciso de orientação sobre uma reclamação trabalhista.';

const situacoes = [
  {
    title: 'Rescisão sem pagamento',
    text: 'Você saiu da empresa e as verbas não vieram, vieram incompletas ou passaram do prazo de dez dias da lei.',
  },
  {
    title: 'Horas extras não pagas',
    text: 'Ficava depois do expediente, entrava antes, almoçava trabalhando ou respondia mensagens fora do horário — sem receber por isso.',
  },
  {
    title: 'FGTS sem depósito',
    text: 'O extrato do FGTS tem meses em branco, ou os descontos do seu holerite não chegaram ao INSS.',
  },
  {
    title: 'Trabalho sem registro',
    text: 'Trabalhou sem carteira assinada, foi contratado como PJ ou recebia parte do salário por fora.',
  },
  {
    title: 'Assédio no ambiente de trabalho',
    text: 'Humilhação diante dos colegas, ameaça de demissão como cobrança, exposição de metas ou investidas de superiores.',
  },
  {
    title: 'Demissão em período de estabilidade',
    text: 'Foi dispensado grávida, logo após acidente de trabalho, no retorno do afastamento pelo INSS ou como cipeiro.',
  },
];

const frentes = [
  {
    title: 'Verbas rescisórias e a multa do atraso',
    text: 'Aviso prévio, saldo de salário, férias com um terço, 13º proporcional, FGTS e a multa de 40%. O pagamento fora do prazo do art. 477 da CLT gera multa de um salário em favor do trabalhador.',
  },
  {
    title: 'Horas extras, intervalo e adicionais',
    text: 'Reconstruo a jornada real a partir de cartões de ponto, escalas, mensagens e testemunhas, com pedido das horas, do intervalo suprimido, do adicional noturno e dos reflexos em férias, 13º e FGTS.',
  },
  {
    title: 'Reconhecimento de vínculo',
    text: 'Havendo pessoalidade, habitualidade, subordinação e salário, o contrato pode ser reconhecido mesmo sob a forma de PJ, cooperativa ou trabalho sem registro — com anotação na carteira e todos os reflexos.',
  },
  {
    title: 'Rescisão indireta',
    text: 'Quando é a empresa que descumpre o contrato — atraso de salário, FGTS não depositado, assédio, desvio de função —, é possível romper o vínculo por culpa dela e receber como em uma dispensa sem justa causa.',
  },
  {
    title: 'Assédio, acidente e danos morais',
    text: 'Indenização por assédio moral ou sexual, revista vexatória, exposição indevida e acidente de trabalho ou doença ocupacional, com discussão de estabilidade e pensionamento.',
  },
  {
    title: 'Estabilidade e reintegração',
    text: 'Gestante, cipeiro, acidentado e quem retorna de afastamento têm estabilidade no emprego. Cabe pedir a reintegração ou a indenização do período garantido.',
  },
];

const primeirasHoras = {
  fazer: [
    'Guarde tudo que registre a sua rotina: holerites, cartões de ponto, escalas, e-mails, ordens de serviço e conversas com a chefia.',
    'Baixe o extrato do FGTS e o extrato do CNIS enquanto ainda tem acesso — depois do desligamento fica mais difícil reunir.',
    'Anote nome e contato de colegas que conheciam a sua jornada. Na Justiça do Trabalho, a testemunha é a prova mais usada.',
    'Salve as mensagens dos grupos de trabalho, as metas e as escalas antes de perder o acesso ao sistema da empresa.',
    'Confira o termo de rescisão (TRCT) item por item e fale com um advogado antes de assinar qualquer quitação.',
  ],
  evitar: [
    'Assinar termo de quitação total, acordo ou plano de desligamento sem entender o que exatamente está sendo quitado.',
    'Apagar conversas com a chefia ou sair dos grupos de trabalho: é ali que costuma estar a prova da jornada e das ordens.',
    'Aceitar acerto por fora, sem recibo discriminado das verbas — o pagamento informal costuma ser difícil de comprovar depois.',
    'Deixar o prazo correr. São dois anos após o fim do contrato para ajuizar, e a ação alcança os últimos cinco anos trabalhados.',
    'Expor a empresa ou o caso nas redes sociais: o que você publica pode ser usado como prova contra você no processo.',
  ],
};

/** Verbas que costumam ficar de fora do acerto — a seção 01 é uma lista de conferência. */
const verbas = [
  { title: 'Aviso prévio', text: 'Indenizado ou trabalhado, com acréscimo de três dias por ano de casa, até 90 dias.' },
  { title: 'Saldo de salário', text: 'Os dias efetivamente trabalhados no mês do desligamento.' },
  { title: 'Férias vencidas e proporcionais', text: 'Sempre com o acréscimo de um terço, inclusive sobre o período proporcional.' },
  { title: '13º proporcional', text: 'Um doze avos por mês trabalhado, contando como mês inteiro a fração acima de 14 dias.' },
  { title: 'FGTS e multa de 40%', text: 'Todos os depósitos do contrato mais a multa rescisória na dispensa sem justa causa.' },
  { title: 'Horas extras e reflexos', text: 'As horas além da jornada e o efeito delas em férias, 13º, aviso e FGTS.' },
  { title: 'Adicionais', text: 'Noturno, insalubridade, periculosidade e acúmulo de função, quando presentes na rotina.' },
  { title: 'Guias do seguro-desemprego', text: 'A entrega das guias e a baixa na carteira também são obrigação da empresa.' },
];

/** Marcos de prazo — a seção 03 é uma linha do tempo, não uma lista de urgência. */
const prazos = [
  {
    marco: '10 dias',
    title: 'Prazo do acerto',
    text: 'A empresa tem dez dias corridos após o fim do contrato para pagar as verbas. Passou disso, cabe a multa do art. 477 da CLT, equivalente a um salário.',
  },
  {
    marco: '2 anos',
    title: 'Prazo para ajuizar',
    text: 'Contados do último dia do contrato. Depois disso o direito prescreve, mesmo que a empresa nunca tenha pago nada.',
  },
  {
    marco: '5 anos',
    title: 'Alcance da cobrança',
    text: 'Dentro daqueles dois anos, a ação alcança as verbas dos cinco anos anteriores ao ajuizamento. Cada mês parado apaga um mês de direito.',
  },
];

/** Checklist da seção 05: o que trazer para a primeira conversa. */
const documentos = [
  'Carteira de trabalho (física ou o print da CTPS Digital)',
  'Contrato de trabalho e aditivos, se houver',
  'Últimos holerites — de preferência os doze últimos',
  'Cartões de ponto, escalas ou espelho da jornada',
  'Termo de rescisão (TRCT) e comprovante do que foi pago',
  'Extrato do FGTS e extrato do CNIS',
  'Conversas com a chefia sobre horário, metas e ordens',
  'Nome e contato de colegas que conheciam a sua rotina',
];

const etapas = [
  {
    n: '01',
    title: 'Triagem do caso',
    text: 'Converso com você para entender a rotina de trabalho, como foi a saída e o que a empresa já pagou.',
  },
  {
    n: '02',
    title: 'Análise dos documentos',
    text: 'Leio contrato, holerites, cartões de ponto, TRCT e extratos do FGTS para separar o que é devido do que ainda depende de prova.',
  },
  {
    n: '03',
    title: 'Cálculo e ajuizamento',
    text: 'Levanto os valores, defino os pedidos e ajuízo a reclamação na Vara do Trabalho competente.',
  },
  {
    n: '04',
    title: 'Audiências e execução',
    text: 'Acompanho as audiências, produzo a prova testemunhal e sigo na execução do que for reconhecido até o crédito ser pago.',
  },
];

const faqs = [
  {
    q: 'Qual é o prazo para entrar com a reclamação trabalhista?',
    a: 'São dois anos contados do fim do contrato. Dentro desse prazo, a ação pode cobrar as verbas dos últimos cinco anos trabalhados.',
  },
  {
    q: 'Assinei o termo de rescisão. Ainda posso reclamar?',
    a: 'Sim. A assinatura do TRCT quita apenas os valores ali discriminados, e não o contrato inteiro. Verbas não pagas continuam exigíveis dentro do prazo.',
  },
  {
    q: 'Fui contratado como PJ. Tenho os direitos da CLT?',
    a: 'Depende de como o trabalho acontecia. Havendo pessoalidade, habitualidade, subordinação e salário, o vínculo de emprego pode ser reconhecido mesmo com contrato de prestação de serviços assinado.',
  },
  {
    q: 'Preciso pagar custas para entrar com a ação?',
    a: 'A Justiça do Trabalho concede gratuidade a quem comprova não ter condições de arcar com as custas. Os honorários são combinados por escrito antes de qualquer trabalho.',
  },
  {
    q: 'Ainda estou trabalhando na empresa. Posso reclamar?',
    a: 'Pode. A lei proíbe represália por ajuizamento de reclamação. Ainda assim, avaliamos juntos o momento e as consequências práticas antes de qualquer passo.',
  },
  {
    q: 'O atendimento pode ser feito a distância?',
    a: 'Sim. Atendo presencialmente no Centro de Florianópolis e por videoconferência, com envio de documentos por meio digital.',
  },
];

const schema = [
  {
    '@type': 'Service',
    name: 'Reclamação trabalhista para o trabalhador em Florianópolis',
    description:
      'Atuação em reclamações trabalhistas pelo lado do empregado: verbas rescisórias, horas extras, reconhecimento de vínculo, rescisão indireta, assédio e estabilidade.',
    serviceType: 'Reclamação trabalhista — defesa do colaborador',
    category: 'Direito do Trabalho',
    provider: { '@id': `${origin}/#escritorio` },
    areaServed: { '@type': 'City', name: 'Florianópolis' },
    termsOfService: `${origin}/termos-de-uso`,
  },
  {
    '@type': 'WebPage',
    url: canonical,
    name: 'Reclamação trabalhista — defesa do colaborador',
    dateModified: revisadoEm,
    about: { '@id': `${origin}/#escritorio` },
    ...(advogado
      ? {
          reviewedBy: {
            '@type': 'Attorney',
            name: advogado.name,
            url: `${origin}/escritorio/${advogado.slug}`,
            ...(advogado.oab ? { identifier: advogado.oab } : {}),
          },
        }
      : {}),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="author" content={site.legalName} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:image" content={`${origin}/og.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#0f4a37" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
		/>

		<title>{title}</title>

		<Schema crumbs={[{ label: 'Reclamação trabalhista' }]} extra={schema} />
	</head>

	<body>
		<a href="#conteudo" class="skip">Pular para o conteúdo</a>

		<header class="topbar">
			<a href="/" class="brand" aria-label={`${site.name} — página inicial`}>
				<span class="brand-mark">KFS</span>
				<span class="brand-text">Sociedade de Advogados</span>
			</a>
			<a class="topbar-cta" href={waLink(waTexto)} target="_blank" rel="noopener">
				Falar com Dr. Asterley
			</a>
		</header>

		<main id="conteudo" tabindex="-1">
			<!-- Hero -->
			<section class="hero" aria-labelledby="hero-title">
				{/* Foto de fundo puramente decorativa: o degradê por cima é que garante
				    o contraste do texto, então ela entra com alt vazio. */}
				<img
					class="hero-bg"
					src="/theme/img/hero-trab-1920.webp"
					srcset="/theme/img/hero-trab-960.webp 960w, /theme/img/hero-trab-1280.webp 1280w, /theme/img/hero-trab-1920.webp 1920w, /theme/img/hero-trab-2560.webp 2560w"
					sizes="100vw"
					width="1920"
					height="1280"
					fetchpriority="high"
					decoding="async"
					alt=""
					aria-hidden="true"
				/>
				<div class="wrap hero-inner">
					<div class="hero-main">
						<p class="eyebrow">Direito do Trabalho · CLT</p>
						<h1 id="hero-title">
							Você trabalhou e não recebeu o que era seu. <em>E o prazo para cobrar já está
							correndo.</em>
						</h1>
						<p class="lead">
							Verbas rescisórias que não vieram, horas extras nunca pagas, FGTS sem depósito,
							carteira sem registro, assédio na rotina. A reclamação trabalhista existe para isso — e
							a prova é mais fácil de reunir agora do que daqui a um ano.
						</p>
						<div class="cta-row">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Asterley
							</a>
							<a class="btn btn-ghost" href={`tel:+${site.whatsapp}`}>
								{site.phone}
							</a>
						</div>
						<p class="hero-note">
							Atendo no Centro de Florianópolis e por videoconferência. {site.hours}.
						</p>
					</div>

				</div>
			</section>

			<!-- Verbas devidas -->
			<section class="band band-sand" aria-labelledby="verbas-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">01</span>
						<h2 id="verbas-title">Você ainda pode ter valores a receber</h2>
						<p class="sec-intro">
							Quase todo acerto é feito na pressa do desligamento, com a conta que a empresa
							apresentou. Confira item por item o que deveria estar nessa conta.
						</p>
					</div>
					<dl class="verbas">
						{verbas.map((v) => (
							<div class="verba">
								<dt>{v.title}</dt>
								<dd>{v.text}</dd>
							</div>
						))}
					</dl>
				</div>
			</section>

			<!-- Frentes de atuação -->
			<section class="band" aria-labelledby="frentes-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">02</span>
						<h2 id="frentes-title">O que eu posso fazer por você</h2>
						<p class="sec-intro">
							O caminho depende de como o contrato foi cumprido e do que ficou registrado. Estas são
							as frentes que costumo colocar em discussão.
						</p>
					</div>
					<ul class="cards">
						{frentes.map((f) => (
							<li class="card">
								<h3>{f.title}</h3>
								<p>{f.text}</p>
							</li>
						))}
					</ul>

					<div class="cta-strip">
						<p class="cta-strip-text">
							Não sabe em qual dessas o seu caso entra? Descreva a sua rotina que eu digo o que dá
							para pedir.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Asterley
							</a>
							<a class="btn btn-line" href="#contato">Enviar o caso</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Prazos -->
			<section class="band band-deep" aria-labelledby="prazos-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">03</span>
						<h2 id="prazos-title">O relógio já está correndo</h2>
						<p class="sec-intro">
							Não é questão de dias, mas também não é para deixar parado. São três prazos diferentes,
							e eles correm ao mesmo tempo.
						</p>
					</div>
					<ol class="prazos">
						{prazos.map((p) => (
							<li class="prazo">
								<span class="prazo-marco" aria-hidden="true">{p.marco}</span>
								<div>
									<h3>{p.title}</h3>
									<p>{p.text}</p>
								</div>
							</li>
						))}
					</ol>

					<div class="cta-strip">
						<p class="cta-strip-text">
							Saiu da empresa há quanto tempo? Em um minuto eu digo se ainda dá para cobrar.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Asterley
							</a>
							<a class="btn btn-ghost" href={`tel:+${site.whatsapp}`}>Ligar</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Prova -->
			<section class="band band-sand" aria-labelledby="prova-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">04</span>
						<h2 id="prova-title">O que pode te ajudar nesse momento</h2>
						<p class="sec-intro">
							O direito continua seu por dois anos. O que muda com o tempo é a facilidade de provar
							— e algumas assinaturas fecham portas que não reabrem.
						</p>
					</div>
					<div class="horas">
						<div class="horas-group">
							<h3 class="split-title split-do">Faça isto agora</h3>
							<p class="split-sub">Estas atitudes preservam a sua prova.</p>
							<ul class="horas-cards">
								{primeirasHoras.fazer.map((i) => (
									<li class="hora-card hora-do">
										<span class="hora-mark" aria-hidden="true">✓</span>
										<p>{i}</p>
									</li>
								))}
							</ul>
						</div>
						<div class="horas-group">
							<h3 class="split-title split-dont">Não faça de jeito nenhum</h3>
							<p class="split-sub">Estas atitudes costumam enfraquecer o seu caso.</p>
							<ul class="horas-cards">
								{primeirasHoras.evitar.map((i) => (
									<li class="hora-card hora-dont">
										<span class="hora-mark" aria-hidden="true">×</span>
										<p>{i}</p>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- Documentos -->
			<section class="band" aria-labelledby="docs-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">05</span>
						<h2 id="docs-title">O que trazer na primeira conversa</h2>
						<p class="sec-intro">
							Não precisa ter tudo para começar — mas cada item desta lista encurta o caminho.
						</p>
					</div>
					<ul class="docs">
						{documentos.map((d) => (
							<li class="doc">
								<span class="doc-mark" aria-hidden="true">✓</span>
								<span>{d}</span>
							</li>
						))}
					</ul>

					<div class="cta-strip">
						<p class="cta-strip-text">
							Tem só parte dos documentos? Comece assim mesmo — o resto dá para reunir depois.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Asterley
							</a>
							<a class="btn btn-line" href="#contato">Enviar o caso</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Como conduzo -->
			<section class="band band-dark band-slate" aria-labelledby="etapas-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">06</span>
						<h2 id="etapas-title">Como eu conduzo a reclamação</h2>
					</div>
					<ol class="steps">
						{etapas.map((e) => (
							<li class="step">
								<span class="step-n" aria-hidden="true">{e.n}</span>
								<div>
									<h3>{e.title}</h3>
									<p>{e.text}</p>
								</div>
							</li>
						))}
					</ol>

					<div class="cta-strip">
						<p class="cta-strip-text">
							A triagem do caso começa por uma conversa comigo, sem compromisso.
						</p>

		<!-- Barra fixa de ação no mobile, onde o CTA do topo sai da tela. -->
		<div class="sticky-cta">
			<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
				Falar com Dr. Asterley
			</a>
			<a class="btn btn-ghost" href="#contato">Enviar o caso</a>
		</div>

		<script is:inline define:vars={{ whatsapp: site.whatsapp }}>
			document.getElementById('lp-form')?.addEventListener('submit', (e) => {
				e.preventDefault();
				const f = e.target;
				const get = (n) => (f.elements[n]?.value || '').trim();
				const erro = document.getElementById('lp-erro');

				const faltando = ['nome', 'telefone', 'mensagem'].filter((n) => !get(n));
				if (faltando.length) {
					erro.textContent = 'Preencha nome, telefone e o relato para enviar.';
					erro.hidden = false;
					const campo = f.elements[faltando[0]];
					campo?.setAttribute('aria-invalid', 'true');
					campo?.focus();
					return;
				}

				erro.hidden = true;
				['nome', 'telefone', 'mensagem'].forEach((n) =>
					f.elements[n]?.removeAttribute('aria-invalid')
				);

				const linhas = [
					`Olá! Meu nome é ${get('nome')}.`,
					'Assunto: reclamação trabalhista.',
					get('fase') && `Fase: ${get('fase')}`,
					`Telefone: ${get('telefone')}`,
					'',
					get('mensagem'),
				].filter(Boolean);

				window.open(
					`https://wa.me/${whatsapp}?text=${encodeURIComponent(linhas.join('\n'))}`,
					'_blank',
					'noopener'
				);
			});
		</script>

		<style is:global>
			/* --- Paleta -------------------------------------------------------
			   Navy da marca com acento azul sereno no lugar do dourado. Três
			   tons porque o mesmo acento aparece sobre fundo escuro e claro:
			   `--calm` só sobre escuro, `--calm-deep` só sobre claro (ambos
			   acima de 4.5:1); `--calm-mid` fica para hover e filetes. */
			:root {
				/* Verde-mata: paleta própria desta landing, para não se confundir com
				   a página criminal. Mesma lógica de três tons de acento — `--calm`
				   só sobre escuro, `--calm-deep` só sobre claro (5:1 no branco). */
				--ink: #17624a;
				--ink-deep: #0f4a37;
				--ink-deep-rgb: 15, 74, 55;
				--sea: #1b7355;
				--calm: #d2eee0;
				--calm-mid: #8fd3b4;
				--calm-deep: #14654a;
				--sand: #eaf6f0;
				--paper: #ffffff;
				--text: #35443f;
				--text-soft: #586a63;
				--line: #cfe7da;
				--line-dark: #ffffff2e;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: var(--paper);
				color: var(--text);
				font-family: 'Manrope', system-ui, -apple-system, sans-serif;
				font-size: 19px;
				line-height: 1.65;
				-webkit-font-smoothing: antialiased;
			}

			h1,
			h2,
			h3 {
				color: var(--ink);
				font-weight: 700;
				letter-spacing: -0.02em;
				line-height: 1.15;
				margin: 0;
			}

			p {
				margin: 0 0 1rem;
			}

			a {
				color: inherit;
			}

			:focus-visible {
				outline: 3px solid var(--calm-mid);
				outline-offset: 3px;
			}

			.wrap {
				width: min(1160px, 100% - 3rem);
				margin-inline: auto;
			}

			.skip {
				position: absolute;
				left: -9999px;
				top: 0;
				background: var(--ink);
				color: #fff;
				padding: 0.75rem 1.25rem;
				z-index: 50;
			}
			.skip:focus {
				left: 0;
			}

			/* --- Topo ---------------------------------------------------------- */
			.topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.1rem clamp(1.5rem, 4vw, 3rem);
				background: var(--ink-deep);
				border-bottom: 1px solid var(--line-dark);
			}

			.brand {
				display: flex;
				align-items: baseline;
				gap: 0.6rem;
				text-decoration: none;
				color: #fff;
			}

			.brand-mark {
				font-size: 1.3rem;
				font-weight: 800;
				letter-spacing: 0.18em;
				color: var(--calm);
			}

			.brand-text {
				font-size: 0.88rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: #ffffffb3;
			}

			.topbar-cta {
				font-size: 0.92rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--calm);
				border-bottom: 1px solid var(--calm-mid);
				padding-bottom: 2px;
			}

			/* --- Botões -------------------------------------------------------- */
			.btn {
				display: inline-block;
				padding: 1.05rem 2rem;
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-decoration: none;
				border: 1px solid transparent;
				transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
			}

			.btn-primary {
				background: var(--calm);
				color: var(--ink);
			}
			.btn-primary:hover {
				background: var(--calm-mid);
			}

			.btn-ghost {
				border-color: currentColor;
				color: inherit;
			}
			.btn-ghost:hover {
				background: #ffffff14;
			}

			/* Contorno para fundo claro — o .btn-ghost usa hover branco translúcido. */
			.btn-line {
				border-color: var(--calm-mid);
				color: var(--calm-deep);
			}
			.btn-line:hover {
				background: var(--sand);
			}

			.btn-block {
				display: block;
				width: 100%;
				text-align: center;
				cursor: pointer;
				font-family: inherit;
			}

			/* --- Hero ---------------------------------------------------------- */
			/* Sem imagem acima da dobra: fundo sólido, zero requisição extra. */
			/* Foto de fundo + degradê grafite: o texto ocupa a faixa esquerda, que é
			   a parte mais fechada do degradê; a imagem respira à direita. */
			.hero {
				position: relative;
				isolation: isolate;
				overflow: hidden;
				background: #0f5480;
				color: #ffffffd9;
				padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(3rem, 7vw, 5.5rem);
			}

			/* A imagem é mais larga que o hero e entra deslocada para a direita: as
			   mãos entrelaçadas, que ficam no terço esquerdo da foto, saem de baixo
			   do degradê e caem na parte clara, ao lado do texto. */
			.hero-inner {
				position: relative;
				width: auto;
				max-width: none;
				margin-inline: 0;
				padding-left: clamp(1.5rem, 6vw, 6rem);
				padding-right: 1.5rem;
			}

			/* A foto é um close: em vez de moldura, ela entra sangrada à direita e
			   se dissolve no verde do hero por uma máscara — sem borda visível. */
			.hero-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 78% 55%;
				z-index: -2;
				-webkit-mask-image: linear-gradient(
					100deg,
					transparent 0%,
					transparent 30%,
					rgba(0, 0, 0, 0.55) 52%,
					#000 78%
				);
				mask-image: linear-gradient(
					100deg,
					transparent 0%,
					transparent 30%,
					rgba(0, 0, 0, 0.55) 52%,
					#000 78%
				);
			}

			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background:
					linear-gradient(
						100deg,
						rgba(20, 20, 20, 0.96) 0%,
						rgba(20, 20, 20, 0.9) 34%,
						rgba(20, 20, 20, 0.5) 64%,
						rgba(20, 20, 20, 0.25) 100%
					),
					linear-gradient(to top, rgba(20, 20, 20, 0.7), rgba(20, 20, 20, 0) 45%);
			}

			/* O limite de largura vive aqui, e não no .hero-inner: com border-box,
			   o padding da margem esquerda seria descontado da coluna e o texto
			   quebraria mais a cada aumento de margem. */
			.hero-main {
				max-width: 36rem;
			}

			.eyebrow {
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--calm);
				margin-bottom: 1.5rem;
			}
			.eyebrow::before {
				content: '';
				display: inline-block;
				width: 2.5rem;
				height: 1px;
				background: var(--calm-mid);
				vertical-align: middle;
				margin-right: 0.9rem;
			}

			.hero h1 {
				color: #fff;
				font-size: clamp(2.05rem, 4.6vw, 3.4rem);
				font-weight: 800;
				max-width: 20ch;
				text-wrap: balance;
			}
			.hero h1 em {
				font-style: normal;
				color: var(--calm);
			}

			.lead {
				font-size: clamp(1.18rem, 1.8vw, 1.38rem);
				color: #ffffffc4;
				max-width: 48ch;
				text-wrap: pretty;
				margin-top: 1.6rem;
			}

			.cta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				margin-top: 2rem;
			}

			.hero-note {
				font-size: 1.12rem;
				color: #a8d8c2;
				margin-top: 1.4rem;
			}

			/* --- CTA no fim de cada seção ---------------------------------------- */
			.cta-strip {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1.2rem 2.5rem;
				margin-top: clamp(2.4rem, 4vw, 3.4rem);
				padding-top: clamp(1.6rem, 3vw, 2.2rem);
				border-top: 1px solid var(--line);
			}
			.band-dark .cta-strip {
				border-top-color: #a8d8c2;
			}
			.cta-strip-text {
				margin: 0;
				max-width: 44ch;
				font-weight: 600;
				font-size: 1.1rem;
			}
			.cta-strip-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
			}

			/* --- Seções -------------------------------------------------------- */
			.band {
				padding: clamp(3.5rem, 8vw, 6.5rem) 0;
			}
			.band-sand {
				background: var(--sand);
			}
			/* Faixas das seções em azul claro: fundo aberto e texto escuro. O hero
			   continua escuro, para contraste com a foto. */
			.band-dark {
				background: var(--calm);
				color: #0e3628;
			}
			.band-slate {
				background: var(--calm);
			}
			/* Verde fechado do rodapé: dá peso à seção de prazos e amarra o fim da
			   página com o começo dela. */
			.band-deep {
				background: var(--ink-deep);
				color: #ffffffc4;
			}
			.band-deep h2,
			.band-deep h3 {
				color: #fff;
			}
			.band-deep .sec-num {
				color: var(--calm-mid);
			}
			.band-deep .cta-strip {
				border-top-color: var(--line-dark);
			}
			/* Faixa branca: usada no contato, para o formulário ficar em destaque
			   sem competir com o azul das outras seções. */
			.band-plain {
				background: var(--paper);
			}
			.band-plain .form {
				background: var(--sand);
				border-color: var(--line);
			}
			.band-plain .contact-list li {
				border-top-color: var(--line);
			}
			.band-plain .contact-list strong {
				color: var(--calm-deep);
			}
			.band-plain .btn-primary {
				background: var(--ink-deep);
				color: #fff;
			}
			.band-plain .btn-primary:hover {
				background: var(--ink);
			}
			.band-dark h2,
			.band-dark h3 {
				color: #0b3226;
			}
			.band-dark .sec-num {
				color: #0f4a37;
			}
			/* Sobre o azul claro o botão claro sumiria: inverte para o azul fechado. */
			.band-dark .btn-primary {
				background: var(--ink-deep);
				color: #fff;
			}
			.band-dark .btn-primary:hover {
				background: var(--ink);
			}
			.band-dark .sec-intro {
				opacity: 1;
				color: #12483a;
			}

			.sec-head {
				max-width: 62ch;
				margin-bottom: clamp(2rem, 4vw, 3rem);
			}

			.sec-num {
				display: block;
				font-size: 0.88rem;
				font-weight: 700;
				letter-spacing: 0.24em;
				color: var(--calm-deep);
				margin-bottom: 0.9rem;
			}

			.sec-head h2 {
				font-size: clamp(1.7rem, 3.4vw, 2.6rem);
			}

			.sec-intro {
				margin-top: 1.1rem;
				color: inherit;
				opacity: 0.85;
			}

			/* --- Cards --------------------------------------------------------- */
			.cards {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.card {
				flex: 1 1 280px;
				background: var(--paper);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.9rem;
			}
			.card h3 {
				font-size: 1.16rem;
				margin-bottom: 0.6rem;
			}
			.card p {
				margin: 0;
				font-size: 1.1rem;
				color: var(--text-soft);
			}

			/* --- Linhas numeradas ---------------------------------------------- */
			.rows {
				list-style: none;
				margin: 0;
				padding: 0;
				counter-reset: linha;
			}

			.row-item {
				counter-increment: linha;
				display: grid;
				grid-template-columns: 4rem minmax(0, 1fr);
				gap: 1.5rem;
				padding: 1.7rem 0;
				border-top: 1px solid var(--line);
			}
			.row-item::before {
				content: counter(linha, decimal-leading-zero);
				font-size: 1.12rem;
				font-weight: 700;
				color: var(--calm-deep);
				letter-spacing: 0.1em;
				padding-top: 0.3rem;
			}
			.row-item h3 {
				font-size: 1.22rem;
				margin-bottom: 0.5rem;
			}
			.row-item p {
				margin: 0;
				color: var(--text-soft);
			}

			/* --- Faça / Evite ---------------------------------------------------
			   Cada orientação vira um card próprio, agrupado em duas listas
			   (verde para o que fazer, vermelho para o que evitar). */
			.horas {
				display: grid;
				gap: clamp(2.2rem, 4vw, 3.2rem);
			}

			/* Flex em vez de grid: com 5 itens, a última linha se estica e ocupa a
			   largura toda, em vez de deixar um card solto ao lado de um vazio. */
			.horas-cards {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.hora-card {
				flex: 1 1 300px;
				display: grid;
				grid-template-columns: 2.6rem minmax(0, 1fr);
				align-items: start;
				gap: 1rem;
				padding: 1.5rem;
				background: var(--paper);
				border: 1px solid #cfd8dc;
				border-radius: 14px;
				box-shadow: 0 10px 26px rgba(var(--ink-deep-rgb), 0.12);
			}
			.hora-card p {
				margin: 0;
				font-size: 1.12rem;
			}
			/* A distinção fica no ícone e num fundo levemente tingido, sem filete
			   colorido no topo: o contraste com o azul da faixa já é suficiente. */
			/* Selo redondo cheio: o sinal precisa ser lido de longe, antes do texto. */
			.hora-mark {
				display: grid;
				place-items: center;
				width: 2.6rem;
				height: 2.6rem;
				border-radius: 50%;
				color: #fff;
				font-weight: 700;
				font-size: 1.5rem;
				line-height: 1;
			}
			.hora-do {
				background: #f4faf6;
				border-color: #cbe3d5;
			}
			.hora-do .hora-mark {
				background: #1e7a52;
			}
			.hora-dont {
				background: #fdf6f4;
				border-color: #e8d0c9;
			}
			.hora-dont .hora-mark {
				background: #b23b28;
				font-size: 1.9rem;
				/* O glifo × sobe um pouco dentro do círculo; o ajuste centraliza. */
				padding-bottom: 0.18rem;
			}

			.split-title {
				font-size: 1.5rem;
				font-weight: 800;
				letter-spacing: 0.02em;
				margin-bottom: 0.35rem;
			}
			/* Uma linha de apoio: só "Faça"/"Evite" não diz o que está em jogo. */
			.split-sub {
				margin: 0 0 1.4rem;
				padding-bottom: 1rem;
				font-size: 1.05rem;
				border-bottom: 1px solid #a8d8c2;
			}
			.split-do {
				color: #0c4d35 !important;
			}
			.split-dont {
				color: #7c2a1c !important;
			}

			/* --- Etapas --------------------------------------------------------- */
			/* Duas colunas largas em vez de quatro estreitas: o texto de cada etapa
			   respira e o número vira um selo, não uma legenda perdida. */
			/* As quatro etapas ficam numa única linha: é uma sequência, e quebrar
			   em duas linhas desmancha a leitura de ordem. */
			.steps {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.25rem;
				grid-template-columns: repeat(4, minmax(0, 1fr));
			}

			.step {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				/* Sem isso as linhas do grid esticam e o texto desce no card mais alto. */
				align-content: start;
				gap: 0.9rem;
				background: var(--paper);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.8rem;
				box-shadow: 0 10px 26px rgba(var(--ink-deep-rgb), 0.07);
			}
			.step-n {
				display: grid;
				place-items: center;
				width: 3rem;
				height: 3rem;
				border-radius: 50%;
				background: var(--calm);
				color: var(--ink-deep);
				font-size: 1.02rem;
				font-weight: 800;
				letter-spacing: 0.04em;
			}
			.step h3 {
				font-size: 1.12rem;
				margin-bottom: 0.5rem;
			}
			.step p {
				margin: 0;
				font-size: 1.1rem;
				color: var(--text-soft);
			}

			/* --- Advogado -------------------------------------------------------- */
			.lawyer {
				display: grid;
				grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
				gap: clamp(1.8rem, 4vw, 3.2rem);
				align-items: start;
			}

			.lawyer-photo {
				margin: 0;
				border-top: 3px solid var(--calm-mid);
				background: var(--sand);
			}
			.lawyer-photo img {
				display: block;
				width: 100%;
				height: auto;
			}

			.lawyer-name {
				font-size: clamp(1.3rem, 2.4vw, 1.7rem);
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 0.2rem;
			}

			.lawyer-role {
				font-size: 0.88rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--calm-deep);
				margin-bottom: 1.4rem;
			}

			.lawyer-bio {
				max-width: 62ch;
			}

			.lawyer-tags {
				list-style: none;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 1.4rem 0 0;
				padding: 0;
			}
			.lawyer-tags li {
				font-size: 1.12rem;
				color: var(--calm-deep);
				border: 1px solid var(--line);
				background: var(--sand);
				padding: 0.4rem 0.9rem;
			}

			.lawyer-facts {
				margin: 2rem 0 0;
				border-top: 1px solid var(--line);
			}
			.lawyer-facts dt {
				font-weight: 700;
				color: var(--ink);
				font-size: 1.12rem;
				padding-top: 1.1rem;
			}
			.lawyer-facts dd {
				margin: 0.35rem 0 1.1rem;
				font-size: 1.1rem;
				color: var(--text-soft);
				border-bottom: 1px solid var(--line);
				padding-bottom: 1.1rem;
			}

			/* --- FAQ ------------------------------------------------------------ */
			.faq {
				border-top: 1px solid var(--line);
				max-width: 80ch;
			}

			.faq-item {
				border-bottom: 1px solid var(--line);
			}
			.faq-item summary {
				cursor: pointer;
				list-style: none;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 1.35rem 0;
				font-weight: 600;
				color: var(--ink);
			}
			.faq-item summary::-webkit-details-marker {
				display: none;
			}
			.faq-item summary::after {
				content: '+';
				color: var(--calm-deep);
				font-size: 1.4rem;
				line-height: 1;
				flex: none;
			}
			.faq-item[open] summary::after {
				content: '–';
			}
			.faq-item p {
				margin: 0 0 1.4rem;
				max-width: 70ch;
				color: var(--text-soft);
			}

			/* --- Contato -------------------------------------------------------- */
			.contact-grid {
				display: grid;
				gap: clamp(2rem, 5vw, 4rem);
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				align-items: start;
			}

			.contact-list {
				list-style: none;
				margin: 2rem 0 0;
				padding: 0;
				font-size: 1.1rem;
			}
			.contact-list li {
				padding: 0.75rem 0;
				border-top: 1px solid #a8d8c2;
			}
			.contact-list strong {
				display: block;
				font-size: 0.88rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: #0f4a37;
				margin-bottom: 0.2rem;
			}

			.form {
				background: var(--paper);
				border: 1px solid #a8d8c2;
				border-radius: 14px;
				padding: clamp(1.5rem, 3vw, 2.2rem);
			}

			.field {
				margin-bottom: 1.1rem;
			}
			.field label {
				display: block;
				font-size: 1.1rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-soft);
				margin-bottom: 0.5rem;
			}
			.field input,
			.field select,
			.field textarea {
				width: 100%;
				background: var(--paper);
				border: 1px solid var(--line);
				color: var(--text);
				font-family: inherit;
				font-size: 1.12rem;
				padding: 0.85rem 1rem;
			}
			.field textarea {
				resize: vertical;
			}
			.field [aria-invalid='true'] {
				border-color: #b4402d;
			}

			.form-error {
				color: #8f2f1f;
				font-size: 1.12rem;
			}

			.form-note {
				font-size: 1.12rem;
				color: var(--text-soft);
				margin: 0.9rem 0 0;
			}

			/* --- Rodapé --------------------------------------------------------- */
			.foot {
				background: var(--ink-deep);
				color: #a8d8c2;
				font-size: 1.1rem;
				padding: 3rem 0 5.5rem;
			}
			.foot-grid {
				display: grid;
				gap: 2rem;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			}
			.foot-name {
				color: #fff;
				font-weight: 600;
			}
			.foot a {
				color: var(--calm);
			}
			.foot-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1.2rem;
				margin-top: 1.2rem;
			}

			/* --- WhatsApp flutuante ---------------------------------------------- */
			.wa-float {
				position: fixed;
				right: 1.5rem;
				bottom: 1.5rem;
				z-index: 45;
				display: grid;
				place-items: center;
				width: 60px;
				height: 60px;
				border-radius: 50%;
				background: #25d366;
				color: #fff;
				box-shadow: 0 6px 20px rgba(var(--ink-deep-rgb), 0.35);
				transition: background-color 0.2s ease, transform 0.2s ease;
			}
			/* Onda em um ::before atrás do botão: o pulso não deforma o ícone
			   nem atrapalha o hover. */
			.wa-float::before {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: inherit;
				background: #25d366;
				z-index: -1;
				animation: wa-pulse 2.2s ease-out infinite;
			}
			@keyframes wa-pulse {
				0% {
					transform: scale(1);
					opacity: 0.55;
				}
				70%,
				100% {
					transform: scale(1.4);
					opacity: 0;
				}
			}
			.wa-float:hover {
				background: #1ebe5a;
				transform: scale(1.06);
			}
			@media (prefers-reduced-motion: reduce) {
				.wa-float::before {
					animation: none;
				}
			}

			/* --- CTA fixo (mobile) ---------------------------------------------- */
			.sticky-cta {
				display: none;
			}

			@media (max-width: 860px) {
				.lawyer {
					grid-template-columns: 1fr;
				}
				/* Quatro colunas não cabem no celular: viram duas. */
				.steps {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.hero-inner {
					max-width: none;
				}
				/* Sem espaço lateral no celular: a foto se dissolve para cima. */
				.hero-bg {
					-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 65%);
					mask-image: linear-gradient(to bottom, transparent 0%, #000 65%);
					object-position: 60% 55%;
				}
				.hero::after {
					background: linear-gradient(
						180deg,
						rgba(20, 20, 20, 0.92) 0%,
						rgba(20, 20, 20, 0.8) 45%,
						rgba(20, 20, 20, 0.95) 100%
					);
				}
				.wa-float {
					width: 54px;
					height: 54px;
					right: 1rem;
					bottom: 5.25rem;
				}
				.row-item {
					grid-template-columns: 2.5rem minmax(0, 1fr);
					gap: 1rem;
				}
				.sticky-cta {
					position: fixed;
					inset: auto 0 0 0;
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: 1px;
					background: var(--ink-deep);
					padding: 0.6rem;
					z-index: 40;
					box-shadow: 0 -6px 24px #00000040;
				}
				.sticky-cta .btn {
					padding: 0.9rem 0.5rem;
					text-align: center;
					font-size: 1.12rem;
				}
				.sticky-cta .btn-ghost {
					color: #fff;
				}
			}

			/* 390px de largura: título, telefone e CTA precisam caber sem rolagem. */
			@media (max-width: 480px) {
				.steps {
					grid-template-columns: minmax(0, 1fr);
				}
				.hero {
					padding: 2.25rem 0 2.75rem;
				}
				.eyebrow {
					margin-bottom: 1rem;
				}
				.hero h1 {
					font-size: clamp(1.75rem, 7.5vw, 2.15rem);
				}
				.lead {
					font-size: 1.12rem;
					margin-top: 1.1rem;
				}
				.cta-row {
					margin-top: 1.5rem;
					gap: 0.6rem;
				}
				.cta-strip-actions {
					width: 100%;
				}
				.cta-strip-actions .btn {
					flex: 1 1 100%;
					text-align: center;
				}
				.cta-row .btn {
					flex: 1 1 auto;
					text-align: center;
					padding: 0.95rem 1rem;
				}
				.hero-note {
					margin-top: 1rem;
					font-size: 0.92rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
				* {
					transition: none !important;
				}
			}

			/* --- Lista de conferência das verbas (01) ----------------------------
			   Flex, e não grid: com oito itens a última linha estica e não sobra
			   célula vazia quando a quantidade não fecha com o número de colunas. */
			.verbas {
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.verba {
				flex: 1 1 320px;
				background: var(--paper);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.5rem 1.7rem;
			}
			.verba dt {
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 0.3rem;
			}
			.verba dd {
				margin: 0;
				font-size: 1.02rem;
				color: var(--text-soft);
			}

			/* --- Linha do tempo dos prazos (03) ---------------------------------- */
			.prazos {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.25rem;
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
			.prazo {
				display: grid;
				align-content: start;
				gap: 0.9rem;
				background: var(--paper);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.8rem;
			}
			.prazo-marco {
				justify-self: start;
				padding: 0.35rem 0.9rem;
				border-radius: 999px;
				background: var(--ink-deep);
				color: #fff;
				font-size: 1.05rem;
				font-weight: 800;
			}
			.prazo h3 {
				font-size: 1.12rem;
				margin-bottom: 0.4rem;
			}
			.prazo p {
				margin: 0;
				font-size: 1.05rem;
				color: var(--text-soft);
			}

			/* --- Checklist de documentos (05) ------------------------------------ */
			.docs {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.9rem 2rem;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			}
			.doc {
				display: grid;
				grid-template-columns: 1.9rem minmax(0, 1fr);
				align-items: start;
				gap: 0.8rem;
				padding: 0.9rem 0;
				border-bottom: 1px solid var(--line);
				font-size: 1.05rem;
			}
			.doc-mark {
				display: grid;
				place-items: center;
				width: 1.9rem;
				height: 1.9rem;
				border-radius: 50%;
				background: var(--calm);
				color: var(--calm-deep);
				font-weight: 700;
				font-size: 1rem;
			}

			@media (max-width: 860px) {
				.prazos {
					grid-template-columns: minmax(0, 1fr);
				}
			}
		</style>
	</body>
</html>

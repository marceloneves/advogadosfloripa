---
/**
 * Landing page autônoma: não usa o Layout do tema (Header, Footer, Bootstrap,
 * jQuery). O objetivo é uma página de conversão com identidade própria, peso
 * mínimo e nenhum caminho de saída além dos CTAs.
 *
 * Publicidade dentro do Código de Ética e do Provimento 205/2021 da OAB:
 * sem promessa de resultado, sem preço, sem depoimento de cliente, sem
 * mercantilização. Tom informativo e sóbrio.
 */
import Schema from '../components/Schema.astro';
import { site, waLink } from '../data/site';
import { getLawyer } from '../data/team';

const advogado = getLawyer('fernando-fabre');

const origin = (Astro.site ?? new URL('https://kfsadvogados.com.br')).origin;
const canonical = `${origin}/defesa-maria-da-penha`;

const title = 'Defesa do Homem na Lei Maria da Penha | KFS Advogados';
const description =
  'Defesa técnica de acusados na Lei 11.340/06 em Florianópolis: revogação de medida protetiva, resposta à acusação, habeas corpus e convivência com os filhos.';

/**
 * A bio de team.ts está em terceira pessoa e é usada nas páginas do escritório.
 * Esta landing fala na voz do próprio advogado, então tem a sua própria versão.
 */
const bioPrimeiraPessoa =
  'Sou advogado com trajetória no Direito Criminal, Militar e Administrativo. Atuei por oito anos como Oficial (1º Tenente) da Força Aérea Brasileira, chefiando a Assessoria Jurídica ao Comando da Base Aérea de Florianópolis, e por três anos como Residente Jurídico junto ao Ministério Público de Santa Catarina. Atuo em Tribunal do Júri, crimes financeiros, questões de vencimentos e pensões militares, defesa de servidores públicos e obtenção de registro e porte de arma de fogo. Sou membro das Comissões de Direito Militar e de Direito do Servidor Público da OAB/SC.';

/** Sem o número em team.ts, a inscrição fica marcada até ser preenchida. */
const oabAdvogado = 'OAB/SC nº [INSERIR NÚMERO OAB]';

const revisadoEm = '2026-08-10';
const revisadoLabel = '10 de agosto de 2026';

/** Mensagem inicial do WhatsApp: já chega com contexto para a triagem. */
const waTexto = 'Olá! Preciso de defesa em um caso da Lei Maria da Penha.';

const situacoes = [
  {
    title: 'Medida protetiva decretada',
    text: 'Você foi afastado de casa, proibido de se aproximar ou de manter contato — muitas vezes antes de ser ouvido.',
  },
  {
    title: 'Boletim de ocorrência registrado',
    text: 'Há um registro na delegacia e um inquérito em andamento, e você ainda não apresentou a sua versão.',
  },
  {
    title: 'Intimação para depor',
    text: 'Foi chamado a prestar depoimento na delegacia ou intimado de uma audiência e não sabe o que dizer.',
  },
  {
    title: 'Prisão em flagrante',
    text: 'Houve condução à delegacia e a audiência de custódia decide, em horas, sobre liberdade ou prisão preventiva.',
  },
  {
    title: 'Acusação de descumprir a medida',
    text: 'Um contato — mesmo indireto ou por terceiros — virou nova acusação, com risco de prisão preventiva.',
  },
  {
    title: 'Filhos no meio do conflito',
    text: 'O afastamento do lar virou, na prática, perda de convivência com os filhos, sem que isso fosse discutido.',
  },
];

const frentes = [
  {
    title: 'Revogação ou revisão da medida protetiva',
    text: 'A medida é concedida em cognição sumária, com base no relato inicial. É provisória e pode ser revista a qualquer tempo, com pedido fundamentado e prova que afaste a situação de risco.',
  },
  {
    title: 'Resposta à acusação e produção de prova',
    text: 'É a primeira defesa escrita apresentada no processo. Nela entram o arrolamento de testemunhas e a juntada de mensagens, áudios e documentos que contextualizem os fatos narrados.',
  },
  {
    title: 'Habeas corpus e liberdade',
    text: 'Atuo na audiência de custódia, peço liberdade provisória, o relaxamento da prisão ilegal e impetro habeas corpus ao tribunal.',
  },
  {
    title: 'Convivência com os filhos',
    text: 'O afastamento do lar não extingue o direito de convivência. É possível pedir a regulamentação da visitação, inclusive em ambiente assistido.',
  },
  {
    title: 'Defesa em audiência',
    text: 'Pergunto às testemunhas, acompanho o depoimento de quem denunciou e apresento a sua defesa ao juiz.',
  },
  {
    title: 'Recursos',
    text: 'Recorro da decisão que impôs ou manteve as medidas e da eventual sentença condenatória.',
  },
];

const primeirasHoras = {
  fazer: [
    'Cumpra a medida protetiva à risca, mesmo discordando dela. Descumprir é crime autônomo (art. 24-A da Lei 11.340/06) e é o caminho mais rápido para a prisão preventiva.',
    'Preserve as conversas, e-mails, áudios e registros de câmera do período. Faça cópia de segurança sem apagar nada do aparelho.',
    'Anote nomes e contatos de quem presenciou os fatos ou conhece a rotina do casal.',
    'Reúna os documentos que já existirem: cópia do B.O., da decisão, da intimação e do inquérito.',
    'Fale com um advogado antes de prestar qualquer depoimento — o direito ao silêncio e à assistência é constitucional (art. 5º, LXIII).',
  ],
  evitar: [
    'Procurar a suposta vítima para "resolver", direta ou indiretamente, por familiares, amigos ou redes sociais.',
    'Apagar mensagens, fotos ou publicações. Além de destruir prova que pode favorecer a defesa, o gesto é lido contra você.',
    'Expor o caso publicamente ou publicar sobre a outra parte.',
    'Voltar ao imóvel para buscar objetos sem autorização judicial.',
    'Assinar termos ou dar versão dos fatos sem defesa técnica presente.',
  ],
};

const etapas = [
  {
    n: '01',
    title: 'Triagem do caso',
    text: 'Converso com você para entender o que aconteceu, em que fase está o procedimento e o que é urgente nas próximas horas.',
  },
  {
    n: '02',
    title: 'Leitura dos autos',
    text: 'Leio a decisão que impôs as medidas, o inquérito e o expediente da delegacia, para identificar o que a acusação efetivamente sustenta.',
  },
  {
    n: '03',
    title: 'Estratégia e atuação imediata',
    text: 'Defino as medidas cabíveis — revogação, habeas corpus, regulamentação de visitas — e protocolo, atuando no plantão judiciário quando o caso exige.',
  },
  {
    n: '04',
    title: 'Defesa até o fim do processo',
    text: 'Apresento a resposta à acusação, produzo a prova, acompanho as audiências e, se necessário, recorro aos tribunais.',
  },
];

const faqs = [
  {
    q: 'Posso pedir a revogação da medida protetiva?',
    a: 'Sim. A medida é provisória e pode ser revista a qualquer tempo, com pedido fundamentado e provas que afastem a situação de risco.',
  },
  {
    q: 'Posso ver meus filhos se fui afastado de casa?',
    a: 'O afastamento do lar não elimina o direito de convivência. É possível pedir ao juízo a regulamentação da visitação, inclusive em ambiente assistido.',
  },
  {
    q: 'A retratação da vítima encerra o processo?',
    a: 'Depende do crime. Em lesão corporal a ação é pública incondicionada e segue mesmo com retratação; em outros casos a manifestação da vítima tem efeito, dentro do prazo legal.',
  },
  {
    q: 'Fui acusado sem prova nenhuma. Isso basta para arquivar?',
    a: 'Não automaticamente. A palavra da vítima tem peso relevante nesses processos, mas deve ser coerente e é confrontada com o restante das provas. Por isso a defesa se constrói com contexto, testemunhas e documentos, e não apenas com a negativa dos fatos.',
  },
  {
    q: 'Um contato feito por outra pessoa conta como descumprimento?',
    a: 'Pode contar. O contato indireto, por intermédio de familiares, amigos ou perfis em redes sociais, costuma ser tratado como descumprimento da medida. Na dúvida sobre o que é permitido, me pergunte antes de agir.',
  },
  {
    q: 'O atendimento pode ser feito a distância?',
    a: 'Sim. Atendo presencialmente no Centro de Florianópolis e por videoconferência, com envio de documentos por meio digital.',
  },
];

const schema = [
  {
    '@type': 'Service',
    name: 'Defesa do homem na Lei Maria da Penha em Florianópolis',
    description:
      'Defesa técnica de acusados na Lei 11.340/06: revogação de medidas protetivas, resposta à acusação, habeas corpus e regulamentação de convivência com os filhos.',
    serviceType: 'Defesa criminal — Lei Maria da Penha',
    category: 'Direito Criminal',
    provider: { '@id': `${origin}/#escritorio` },
    areaServed: { '@type': 'City', name: 'Florianópolis' },
    termsOfService: `${origin}/termos-de-uso`,
  },
  {
    '@type': 'WebPage',
    url: canonical,
    name: 'Defesa do homem na Lei Maria da Penha',
    dateModified: revisadoEm,
    about: { '@id': `${origin}/#escritorio` },
    ...(advogado
      ? {
          reviewedBy: {
            '@type': 'Attorney',
            name: advogado.name,
            url: `${origin}/escritorio/${advogado.slug}`,
            ...(advogado.oab ? { identifier: advogado.oab } : {}),
          },
        }
      : {}),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="author" content={site.legalName} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:image" content={`${origin}/og.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#0f5480" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
		/>

		<title>{title}</title>

		<Schema crumbs={[{ label: 'Defesa na Lei Maria da Penha' }]} extra={schema} />
	</head>

	<body>
		<a href="#conteudo" class="skip">Pular para o conteúdo</a>

		<header class="topbar">
			<a href="/" class="brand" aria-label={`${site.name} — página inicial`}>
				<span class="brand-mark">KFS</span>
				<span class="brand-text">Sociedade de Advogados</span>
			</a>
			<a class="topbar-cta" href={waLink(waTexto)} target="_blank" rel="noopener">
				Falar com Dr. Fernando
			</a>
		</header>

		<main id="conteudo" tabindex="-1">
			<!-- Hero -->
			<section class="hero" aria-labelledby="hero-title">
				{/* Foto de fundo puramente decorativa: o degradê por cima é que garante
				    o contraste do texto, então ela entra com alt vazio. */}
				<img
					class="hero-bg"
					src="/theme/img/hero-mdp-1920.webp"
					srcset="/theme/img/hero-mdp-960.webp 960w, /theme/img/hero-mdp-1280.webp 1280w, /theme/img/hero-mdp-1920.webp 1920w, /theme/img/hero-mdp-2560.webp 2560w"
					sizes="100vw"
					width="1920"
					height="1280"
					fetchpriority="high"
					decoding="async"
					alt=""
					aria-hidden="true"
				/>
				<div class="wrap hero-inner">
					<div class="hero-main">
						<p class="eyebrow">Direito Criminal · Lei 11.340/06</p>
						<h1 id="hero-title">
							Você foi acusado sob a <em>Lei Maria da Penha</em>. Mas a sua versão ainda não foi ouvida.
						</h1>
						<p class="lead">
							Medida protetiva decretada, afastamento de casa, inquérito aberto, audiência de
							custódia marcada. Você tem o direito de apresentar a sua versão. Quanto antes eu entrar no
							caso, mais coisa ainda dá para mudar.
						</p>
						<div class="cta-row">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Fernando
							</a>
							<a class="btn btn-ghost" href={`tel:+${site.whatsapp}`}>
								{site.phone}
							</a>
						</div>
						<p class="hero-note">
							Atendo no Centro de Florianópolis e por videoconferência. {site.hours}.
						</p>
					</div>
				</div>
			</section>

			<!-- Situações -->
			<section class="band band-sand" aria-labelledby="situacoes-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">01</span>
						<h2 id="situacoes-title">Eu sei o que você está enfrentando</h2>
						<p class="sec-intro">
							A medida protetiva costuma ser decidida às pressas, só com a versão de quem denunciou.
							Ela é provisória: pode ser revista a qualquer momento, desde que o pedido venha com
							fundamento e com prova de que não existe o risco descrito.
						</p>
					</div>
					<ul class="cards">
						{situacoes.map((s) => (
							<li class="card">
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))}
					</ul>
				</div>
			</section>

			<!-- Frentes de atuação -->
			<section class="band" aria-labelledby="frentes-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">02</span>
						<h2 id="frentes-title">O que eu posso fazer por você</h2>
						<p class="sec-intro">
							O caminho depende da fase do procedimento e do que consta nos autos. Estas são as
							medidas que costumo colocar em discussão.
						</p>
					</div>
					<ol class="rows">
						{frentes.map((f) => (
							<li class="row-item">
								{/* Wrapper obrigatório: o ::before já ocupa a 1ª célula do grid,
								    então título e texto precisam entrar como um único item. */}
								<div>
									<h3>{f.title}</h3>
									<p>{f.text}</p>
								</div>
							</li>
						))}
					</ol>

					<div class="cta-strip">
						<p class="cta-strip-text">
							Cada uma dessas medidas tem prazo próprio. Quanto antes eu entrar no caso, mais caminhos
							seguem abertos.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Fernando
							</a>
							<a class="btn btn-line" href="#contato">Enviar o caso</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Primeiras horas -->
			<section class="band band-dark band-slate" aria-labelledby="horas-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">03</span>
						<h2 id="horas-title">As primeiras horas decidem muita coisa</h2>
						<p class="sec-intro">
							Enquanto você não constitui defesa, o que você faz — ou deixa de fazer — entra no
							processo. Duas listas curtas para o intervalo entre a decisão e o primeiro ato.
						</p>
					</div>
					<div class="horas">
						<div class="horas-group">
							<h3 class="split-title split-do">Faça isto agora</h3>
							<p class="split-sub">Estas atitudes preservam a sua defesa.</p>
							<ul class="horas-cards">
								{primeirasHoras.fazer.map((i) => (
									<li class="hora-card hora-do">
										<span class="hora-mark" aria-hidden="true">✓</span>
										<p>{i}</p>
									</li>
								))}
							</ul>
						</div>
						<div class="horas-group">
							<h3 class="split-title split-dont">Não faça de jeito nenhum</h3>
							<p class="split-sub">Estas atitudes costumam ser lidas contra você no processo.</p>
							<ul class="horas-cards">
								{primeirasHoras.evitar.map((i) => (
									<li class="hora-card hora-dont">
										<span class="hora-mark" aria-hidden="true">×</span>
										<p>{i}</p>
									</li>
								))}
							</ul>
						</div>
					</div>

					<div class="cta-strip">
						<p class="cta-strip-text">
							Está nesse intervalo agora? Fale comigo antes do próximo ato do processo.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Fernando
							</a>
							<a class="btn btn-ghost" href={`tel:+${site.whatsapp}`}>Ligar</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Como conduzo -->
			<section class="band band-sand" aria-labelledby="etapas-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">04</span>
						<h2 id="etapas-title">Como eu conduzo a defesa</h2>
					</div>
					<ol class="steps">
						{etapas.map((e) => (
							<li class="step">
								<span class="step-n" aria-hidden="true">{e.n}</span>
								<div>
									<h3>{e.title}</h3>
									<p>{e.text}</p>
								</div>
							</li>
						))}
					</ol>

					<div class="cta-strip">
						<p class="cta-strip-text">
							A triagem do caso começa por uma conversa comigo, sem compromisso.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Fernando
							</a>
							<a class="btn btn-line" href="#contato">Enviar o caso</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Advogado responsável -->
			{advogado && (
				<section class="band" aria-labelledby="quem-title">
					<div class="wrap">
						<div class="sec-head">
							<span class="sec-num">05</span>
							<h2 id="quem-title">Quem vai te ajudar</h2>
						</div>

						<div class="lawyer">
							<figure class="lawyer-photo">
								<img
									src={advogado.photoCard ?? advogado.photo}
									srcset={(advogado.photoCardWidths ?? [])
										.map((w) => `${advogado.photoCard?.replace(/-\d+\.webp$/, `-${w}.webp`)} ${w}w`)
										.join(', ')}
									sizes="(max-width: 860px) 100vw, 360px"
									width="600"
									height="800"
									loading="lazy"
									decoding="async"
									alt={`Retrato de ${advogado.name}`}
								/>
							</figure>

							<div class="lawyer-body">
								<p class="lawyer-name">{advogado.name}</p>
								<p class="lawyer-role">
									{[advogado.oab ?? oabAdvogado, advogado.role, advogado.city].filter(Boolean).join(' · ')}
								</p>

								<p class="lawyer-bio">{bioPrimeiraPessoa}</p>

								{advogado.roles?.length ? (
									<ul class="lawyer-tags" aria-label="Atuação institucional">
										{advogado.roles.map((r) => <li>{r}</li>)}
									</ul>
								) : null}

								<dl class="lawyer-facts">
									{advogado.experience.slice(0, 3).map((e) => (
										<>
											<dt>{e.title ?? 'Experiência'}</dt>
											<dd>{e.detail}</dd>
										</>
									))}
								</dl>

								<div class="cta-row">
									<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
										Falar com Dr. Fernando
									</a>
									<a class="btn btn-line" href={`/escritorio/${advogado.slug}`}>
										Ver perfil completo
									</a>
								</div>
							</div>
						</div>
					</div>
				</section>
			)}

			<!-- FAQ -->
			<section class="band band-sand" aria-labelledby="faq-title">
				<div class="wrap">
					<div class="sec-head">
						<span class="sec-num">06</span>
						<h2 id="faq-title">Perguntas frequentes</h2>
					</div>
					<div class="faq">
						{faqs.map((f) => (
							<details class="faq-item">
								<summary>
									<span>{f.q}</span>
								</summary>
								<p>{f.a}</p>
							</details>
						))}
					</div>

					<div class="cta-strip">
						<p class="cta-strip-text">
							Ficou uma dúvida que não está aqui? Descreva o caso que eu respondo no retorno.
						</p>
						<div class="cta-strip-actions">
							<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
								Falar com Dr. Fernando
							</a>
							<a class="btn btn-line" href="#contato">Enviar o caso</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Contato -->
			<section class="band band-plain" id="contato" aria-labelledby="contato-title">
				<div class="wrap contact-grid">
					<div>
						<span class="sec-num">07</span>
						<h2 id="contato-title">Conte o que aconteceu</h2>
						<p class="sec-intro">
							Descreva o caso e em que fase ele está. Eu retorno indicando os caminhos possíveis e o que
							é urgente. Nenhuma informação enviada aqui é compartilhada com terceiros.
						</p>
						<p class="sec-intro">
							O primeiro contato serve para eu entender o caso e explicar os caminhos possíveis. Os
							honorários são definidos depois, por escrito.
						</p>
						<ul class="contact-list">
							<li><strong>WhatsApp e telefone</strong> {site.phone}</li>
							<li><strong>E-mail</strong> {site.email}</li>
							<li><strong>Escritório</strong> {site.addressShort}</li>
							<li><strong>Horário</strong> {site.hours}</li>
						</ul>
					</div>

					<form id="lp-form" class="form" novalidate>
						<div class="field">
							<label for="lp-nome">Seu nome</label>
							<input id="lp-nome" name="nome" type="text" autocomplete="name" required />
						</div>
						<div class="field">
							<label for="lp-telefone">Telefone / WhatsApp</label>
							<input
								id="lp-telefone"
								name="telefone"
								type="tel"
								inputmode="tel"
								autocomplete="tel"
								required
							/>
						</div>
						<div class="field">
							<label for="lp-fase">Em que fase está o caso</label>
							<select id="lp-fase" name="fase">
								<option value="">Selecione</option>
								<option>Medida protetiva decretada</option>
								<option>Intimado a depor na delegacia</option>
								<option>Inquérito ou ação penal em andamento</option>
								<option>Prisão em flagrante / audiência de custódia</option>
								<option>Acusação de descumprimento da medida</option>
								<option>Outra situação</option>
							</select>
						</div>
						<div class="field">
							<label for="lp-mensagem">O que aconteceu</label>
							<textarea id="lp-mensagem" name="mensagem" rows="5" required></textarea>
						</div>
						<p id="lp-erro" class="form-error" role="alert" aria-live="polite" hidden></p>
						<button type="submit" class="btn btn-primary btn-block">Falar com Dr. Fernando</button>
						<p class="form-note">
							O envio abre o WhatsApp com a mensagem já preenchida. Você revisa antes de enviar.
						</p>
					</form>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-grid">
				<div>
					<p class="foot-name">{site.legalName}</p>
					<p>{site.address}</p>
					<p>CNPJ {site.cnpj}</p>
				</div>
				<div>
					<p>
						Conteúdo informativo sob responsabilidade de{' '}
						{advogado ? (
							<>
								<a href={`/escritorio/${advogado.slug}`}>{advogado.name}</a>
								{`, ${advogado.oab ?? oabAdvogado}`}
							</>
						) : (
							site.legalName
						)}. Última revisão em <time datetime={revisadoEm}>{revisadoLabel}</time>.
					</p>
					<p>
						Não substitui a análise do caso concreto por um advogado e não implica promessa de
						resultado. Publicidade em conformidade com o Código de Ética e Disciplina e o
						Provimento 205/2021 da OAB.
					</p>
					<p class="foot-links">
						<a href="/">Site institucional</a>
						<a href="/servicos/defesa-maria-da-penha">Área de Direito Criminal</a>
						<a href="/politica-de-privacidade">Privacidade</a>
						<a href="/termos-de-uso">Termos de uso</a>
					</p>
				</div>
			</div>
		</footer>

		<!-- Botão flutuante clássico do WhatsApp: círculo verde da marca, só
		     ícone. No mobile sobe para não colidir com a barra fixa de ação. -->
		<a
			href={waLink(waTexto)}
			class="wa-float"
			target="_blank"
			rel="noopener"
			aria-label="Falar com o Dr. Fernando pelo WhatsApp"
		>
			<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false">
				<path
					fill="currentColor"
					d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.59.25 1.04.4 1.4.52.59.18 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
				/>
			</svg>
		</a>

		<!-- Barra fixa de ação no mobile, onde o CTA do topo sai da tela. -->
		<div class="sticky-cta">
			<a class="btn btn-primary" href={waLink(waTexto)} target="_blank" rel="noopener">
				Falar com um advogado
			</a>
			<a class="btn btn-ghost" href="#contato">Enviar o caso</a>
		</div>

		<script is:inline define:vars={{ whatsapp: site.whatsapp }}>
			document.getElementById('lp-form')?.addEventListener('submit', (e) => {
				e.preventDefault();
				const f = e.target;
				const get = (n) => (f.elements[n]?.value || '').trim();
				const erro = document.getElementById('lp-erro');

				const faltando = ['nome', 'telefone', 'mensagem'].filter((n) => !get(n));
				if (faltando.length) {
					erro.textContent = 'Preencha nome, telefone e o relato para enviar.';
					erro.hidden = false;
					const campo = f.elements[faltando[0]];
					campo?.setAttribute('aria-invalid', 'true');
					campo?.focus();
					return;
				}

				erro.hidden = true;
				['nome', 'telefone', 'mensagem'].forEach((n) =>
					f.elements[n]?.removeAttribute('aria-invalid')
				);

				const linhas = [
					`Olá! Meu nome é ${get('nome')}.`,
					'Assunto: defesa em caso da Lei Maria da Penha.',
					get('fase') && `Fase: ${get('fase')}`,
					`Telefone: ${get('telefone')}`,
					'',
					get('mensagem'),
				].filter(Boolean);

				window.open(
					`https://wa.me/${whatsapp}?text=${encodeURIComponent(linhas.join('\n'))}`,
					'_blank',
					'noopener'
				);
			});
		</script>

		<style is:global>
			/* --- Paleta -------------------------------------------------------
			   Navy da marca com acento azul sereno no lugar do dourado. Três
			   tons porque o mesmo acento aparece sobre fundo escuro e claro:
			   `--calm` só sobre escuro, `--calm-deep` só sobre claro (ambos
			   acima de 4.5:1); `--calm-mid` fica para hover e filetes. */
			:root {
				/* Azul claro: as faixas escuras ficam num azul aberto, ainda fechado o
				   bastante para texto branco (5:1). Três tons de acento porque ele
				   aparece sobre fundo escuro e sobre fundo claro — `--calm` só no
				   escuro, `--calm-deep` só no claro (4.6:1 no branco). */
				--ink: #16699b;
				--ink-deep: #0f5480;
				--ink-deep-rgb: 15, 84, 128;
				--sea: #1b76ac;
				--calm: #cfe9fb;
				--calm-mid: #93cdf0;
				--calm-deep: #17669a;
				--sand: #eaf5fc;
				--paper: #ffffff;
				--text: #37474f;
				--text-soft: #5b6f7a;
				--line: #cfe6f4;
				--line-dark: #ffffff2e;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: var(--paper);
				color: var(--text);
				font-family: 'Manrope', system-ui, -apple-system, sans-serif;
				font-size: 19px;
				line-height: 1.65;
				-webkit-font-smoothing: antialiased;
			}

			h1,
			h2,
			h3 {
				color: var(--ink);
				font-weight: 700;
				letter-spacing: -0.02em;
				line-height: 1.15;
				margin: 0;
			}

			p {
				margin: 0 0 1rem;
			}

			a {
				color: inherit;
			}

			:focus-visible {
				outline: 3px solid var(--calm-mid);
				outline-offset: 3px;
			}

			.wrap {
				width: min(1160px, 100% - 3rem);
				margin-inline: auto;
			}

			.skip {
				position: absolute;
				left: -9999px;
				top: 0;
				background: var(--ink);
				color: #fff;
				padding: 0.75rem 1.25rem;
				z-index: 50;
			}
			.skip:focus {
				left: 0;
			}

			/* --- Topo ---------------------------------------------------------- */
			.topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.1rem clamp(1.5rem, 4vw, 3rem);
				background: var(--ink-deep);
				border-bottom: 1px solid var(--line-dark);
			}

			.brand {
				display: flex;
				align-items: baseline;
				gap: 0.6rem;
				text-decoration: none;
				color: #fff;
			}

			.brand-mark {
				font-size: 1.3rem;
				font-weight: 800;
				letter-spacing: 0.18em;
				color: var(--calm);
			}

			.brand-text {
				font-size: 0.88rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: #ffffffb3;
			}

			.topbar-cta {
				font-size: 0.92rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--calm);
				border-bottom: 1px solid var(--calm-mid);
				padding-bottom: 2px;
			}

			/* --- Botões -------------------------------------------------------- */
			.btn {
				display: inline-block;
				padding: 1.05rem 2rem;
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-decoration: none;
				border: 1px solid transparent;
				transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
			}

			.btn-primary {
				background: var(--calm);
				color: var(--ink);
			}
			.btn-primary:hover {
				background: var(--calm-mid);
			}

			.btn-ghost {
				border-color: currentColor;
				color: inherit;
			}
			.btn-ghost:hover {
				background: #ffffff14;
			}

			/* Contorno para fundo claro — o .btn-ghost usa hover branco translúcido. */
			.btn-line {
				border-color: var(--calm-mid);
				color: var(--calm-deep);
			}
			.btn-line:hover {
				background: var(--sand);
			}

			.btn-block {
				display: block;
				width: 100%;
				text-align: center;
				cursor: pointer;
				font-family: inherit;
			}

			/* --- Hero ---------------------------------------------------------- */
			/* Sem imagem acima da dobra: fundo sólido, zero requisição extra. */
			/* Foto de fundo + degradê grafite: o texto ocupa a faixa esquerda, que é
			   a parte mais fechada do degradê; a imagem respira à direita. */
			.hero {
				position: relative;
				isolation: isolate;
				overflow: hidden;
				background: #0f5480;
				color: #ffffffd9;
				padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(3rem, 7vw, 5.5rem);
			}

			/* A imagem é mais larga que o hero e entra deslocada para a direita: as
			   mãos entrelaçadas, que ficam no terço esquerdo da foto, saem de baixo
			   do degradê e caem na parte clara, ao lado do texto. */
			.hero-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				/* Enquadra as mãos entrelaçadas e a prancheta no lado direito, que é
				   a parte clara do degradê; o texto fica sobre a mesa vazia. */
				object-position: 62% 30%;
				z-index: -2;
			}

			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background:
					linear-gradient(
						100deg,
						rgba(20, 20, 20, 0.96) 0%,
						rgba(20, 20, 20, 0.92) 32%,
						rgba(20, 20, 20, 0.6) 62%,
						rgba(20, 20, 20, 0.28) 100%
					),
					linear-gradient(to top, rgba(20, 20, 20, 0.75), rgba(20, 20, 20, 0) 45%);
			}

			.hero-inner {
				position: relative;
				width: auto;
				max-width: none;
				margin-inline: 0;
				padding-left: clamp(1.5rem, 6vw, 6rem);
				padding-right: 1.5rem;
			}

			/* O limite de largura vive aqui, e não no .hero-inner: com border-box,
			   o padding da margem esquerda seria descontado da coluna e o texto
			   quebraria mais a cada aumento de margem. */
			.hero-main {
				max-width: 36rem;
			}

			.eyebrow {
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--calm);
				margin-bottom: 1.5rem;
			}
			.eyebrow::before {
				content: '';
				display: inline-block;
				width: 2.5rem;
				height: 1px;
				background: var(--calm-mid);
				vertical-align: middle;
				margin-right: 0.9rem;
			}

			.hero h1 {
				color: #fff;
				font-size: clamp(2.05rem, 4.6vw, 3.4rem);
				font-weight: 800;
				max-width: 20ch;
				text-wrap: balance;
			}
			.hero h1 em {
				font-style: normal;
				color: var(--calm);
			}

			.lead {
				font-size: clamp(1.18rem, 1.8vw, 1.38rem);
				color: #ffffffc4;
				max-width: 48ch;
				text-wrap: pretty;
				margin-top: 1.6rem;
			}

			.cta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				margin-top: 2rem;
			}

			.hero-note {
				font-size: 1.12rem;
				color: #a9cfe9;
				margin-top: 1.4rem;
			}

			/* --- CTA no fim de cada seção ---------------------------------------- */
			.cta-strip {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1.2rem 2.5rem;
				margin-top: clamp(2.4rem, 4vw, 3.4rem);
				padding-top: clamp(1.6rem, 3vw, 2.2rem);
				border-top: 1px solid var(--line);
			}
			.band-dark .cta-strip {
				border-top-color: #a9cfe9;
			}
			.cta-strip-text {
				margin: 0;
				max-width: 44ch;
				font-weight: 600;
				font-size: 1.1rem;
			}
			.cta-strip-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
			}

			/* --- Seções -------------------------------------------------------- */
			.band {
				padding: clamp(3.5rem, 8vw, 6.5rem) 0;
			}
			.band-sand {
				background: var(--sand);
			}
			/* Faixas das seções em azul claro: fundo aberto e texto escuro. O hero
			   continua escuro, para contraste com a foto. */
			.band-dark {
				background: var(--calm);
				color: #10344b;
			}
			.band-slate {
				background: var(--calm);
			}
			/* Faixa branca: usada no contato, para o formulário ficar em destaque
			   sem competir com o azul das outras seções. */
			.band-plain {
				background: var(--paper);
			}
			.band-plain .form {
				background: var(--sand);
				border-color: var(--line);
			}
			.band-plain .contact-list li {
				border-top-color: var(--line);
			}
			.band-plain .contact-list strong {
				color: var(--calm-deep);
			}
			.band-plain .btn-primary {
				background: var(--ink-deep);
				color: #fff;
			}
			.band-plain .btn-primary:hover {
				background: var(--ink);
			}
			.band-dark h2,
			.band-dark h3 {
				color: #0b3049;
			}
			.band-dark .sec-num {
				color: #0d3f61;
			}
			/* Sobre o azul claro o botão claro sumiria: inverte para o azul fechado. */
			.band-dark .btn-primary {
				background: var(--ink-deep);
				color: #fff;
			}
			.band-dark .btn-primary:hover {
				background: var(--ink);
			}
			.band-dark .sec-intro {
				opacity: 1;
				color: #12405c;
			}

			.sec-head {
				max-width: 62ch;
				margin-bottom: clamp(2rem, 4vw, 3rem);
			}

			.sec-num {
				display: block;
				font-size: 0.88rem;
				font-weight: 700;
				letter-spacing: 0.24em;
				color: var(--calm-deep);
				margin-bottom: 0.9rem;
			}

			.sec-head h2 {
				font-size: clamp(1.7rem, 3.4vw, 2.6rem);
			}

			.sec-intro {
				margin-top: 1.1rem;
				color: inherit;
				opacity: 0.85;
			}

			/* --- Cards --------------------------------------------------------- */
			.cards {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.card {
				flex: 1 1 280px;
				background: var(--paper);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.9rem;
			}
			.card h3 {
				font-size: 1.16rem;
				margin-bottom: 0.6rem;
			}
			.card p {
				margin: 0;
				font-size: 1.1rem;
				color: var(--text-soft);
			}

			/* --- Linhas numeradas ---------------------------------------------- */
			.rows {
				list-style: none;
				margin: 0;
				padding: 0;
				counter-reset: linha;
			}

			.row-item {
				counter-increment: linha;
				display: grid;
				grid-template-columns: 4rem minmax(0, 1fr);
				gap: 1.5rem;
				padding: 1.7rem 0;
				border-top: 1px solid var(--line);
			}
			.row-item::before {
				content: counter(linha, decimal-leading-zero);
				font-size: 1.12rem;
				font-weight: 700;
				color: var(--calm-deep);
				letter-spacing: 0.1em;
				padding-top: 0.3rem;
			}
			.row-item h3 {
				font-size: 1.22rem;
				margin-bottom: 0.5rem;
			}
			.row-item p {
				margin: 0;
				color: var(--text-soft);
			}

			/* --- Faça / Evite ---------------------------------------------------
			   Cada orientação vira um card próprio, agrupado em duas listas
			   (verde para o que fazer, vermelho para o que evitar). */
			.horas {
				display: grid;
				gap: clamp(2.2rem, 4vw, 3.2rem);
			}

			/* Flex em vez de grid: com 5 itens, a última linha se estica e ocupa a
			   largura toda, em vez de deixar um card solto ao lado de um vazio. */
			.horas-cards {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.hora-card {
				flex: 1 1 300px;
				display: grid;
				grid-template-columns: 2.6rem minmax(0, 1fr);
				align-items: start;
				gap: 1rem;
				padding: 1.5rem;
				background: var(--paper);
				border: 1px solid #cfd8dc;
				border-radius: 14px;
				box-shadow: 0 10px 26px rgba(var(--ink-deep-rgb), 0.12);
			}
			.hora-card p {
				margin: 0;
				font-size: 1.12rem;
			}
			/* A distinção fica no ícone e num fundo levemente tingido, sem filete
			   colorido no topo: o contraste com o azul da faixa já é suficiente. */
			/* Selo redondo cheio: o sinal precisa ser lido de longe, antes do texto. */
			.hora-mark {
				display: grid;
				place-items: center;
				width: 2.6rem;
				height: 2.6rem;
				border-radius: 50%;
				color: #fff;
				font-weight: 700;
				font-size: 1.5rem;
				line-height: 1;
			}
			.hora-do {
				background: #f4faf6;
				border-color: #cbe3d5;
			}
			.hora-do .hora-mark {
				background: #1e7a52;
			}
			.hora-dont {
				background: #fdf6f4;
				border-color: #e8d0c9;
			}
			.hora-dont .hora-mark {
				background: #b23b28;
				font-size: 1.9rem;
				/* O glifo × sobe um pouco dentro do círculo; o ajuste centraliza. */
				padding-bottom: 0.18rem;
			}

			.split-title {
				font-size: 1.5rem;
				font-weight: 800;
				letter-spacing: 0.02em;
				margin-bottom: 0.35rem;
			}
			/* Uma linha de apoio: só "Faça"/"Evite" não diz o que está em jogo. */
			.split-sub {
				margin: 0 0 1.4rem;
				padding-bottom: 1rem;
				font-size: 1.05rem;
				border-bottom: 1px solid #a9cfe9;
			}
			.split-do {
				color: #0c4d35 !important;
			}
			.split-dont {
				color: #7c2a1c !important;
			}

			/* --- Etapas --------------------------------------------------------- */
			/* Duas colunas largas em vez de quatro estreitas: o texto de cada etapa
			   respira e o número vira um selo, não uma legenda perdida. */
			/* As quatro etapas ficam numa única linha: é uma sequência, e quebrar
			   em duas linhas desmancha a leitura de ordem. */
			.steps {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.25rem;
				grid-template-columns: repeat(4, minmax(0, 1fr));
			}

			.step {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				/* Sem isso as linhas do grid esticam e o texto desce no card mais alto. */
				align-content: start;
				gap: 0.9rem;
				background: var(--paper);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.8rem;
				box-shadow: 0 10px 26px rgba(var(--ink-deep-rgb), 0.07);
			}
			.step-n {
				display: grid;
				place-items: center;
				width: 3rem;
				height: 3rem;
				border-radius: 50%;
				background: var(--calm);
				color: var(--ink-deep);
				font-size: 1.02rem;
				font-weight: 800;
				letter-spacing: 0.04em;
			}
			.step h3 {
				font-size: 1.12rem;
				margin-bottom: 0.5rem;
			}
			.step p {
				margin: 0;
				font-size: 1.1rem;
				color: var(--text-soft);
			}

			/* --- Advogado -------------------------------------------------------- */
			.lawyer {
				display: grid;
				grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
				gap: clamp(1.8rem, 4vw, 3.2rem);
				align-items: start;
			}

			.lawyer-photo {
				margin: 0;
				border-top: 3px solid var(--calm-mid);
				background: var(--sand);
			}
			.lawyer-photo img {
				display: block;
				width: 100%;
				height: auto;
			}

			.lawyer-name {
				font-size: clamp(1.3rem, 2.4vw, 1.7rem);
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 0.2rem;
			}

			.lawyer-role {
				font-size: 0.88rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--calm-deep);
				margin-bottom: 1.4rem;
			}

			.lawyer-bio {
				max-width: 62ch;
			}

			.lawyer-tags {
				list-style: none;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 1.4rem 0 0;
				padding: 0;
			}
			.lawyer-tags li {
				font-size: 1.12rem;
				color: var(--calm-deep);
				border: 1px solid var(--line);
				background: var(--sand);
				padding: 0.4rem 0.9rem;
			}

			.lawyer-facts {
				margin: 2rem 0 0;
				border-top: 1px solid var(--line);
			}
			.lawyer-facts dt {
				font-weight: 700;
				color: var(--ink);
				font-size: 1.12rem;
				padding-top: 1.1rem;
			}
			.lawyer-facts dd {
				margin: 0.35rem 0 1.1rem;
				font-size: 1.1rem;
				color: var(--text-soft);
				border-bottom: 1px solid var(--line);
				padding-bottom: 1.1rem;
			}

			/* --- FAQ ------------------------------------------------------------ */
			.faq {
				border-top: 1px solid var(--line);
				max-width: 80ch;
			}

			.faq-item {
				border-bottom: 1px solid var(--line);
			}
			.faq-item summary {
				cursor: pointer;
				list-style: none;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 1.35rem 0;
				font-weight: 600;
				color: var(--ink);
			}
			.faq-item summary::-webkit-details-marker {
				display: none;
			}
			.faq-item summary::after {
				content: '+';
				color: var(--calm-deep);
				font-size: 1.4rem;
				line-height: 1;
				flex: none;
			}
			.faq-item[open] summary::after {
				content: '–';
			}
			.faq-item p {
				margin: 0 0 1.4rem;
				max-width: 70ch;
				color: var(--text-soft);
			}

			/* --- Contato -------------------------------------------------------- */
			.contact-grid {
				display: grid;
				gap: clamp(2rem, 5vw, 4rem);
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				align-items: start;
			}

			.contact-list {
				list-style: none;
				margin: 2rem 0 0;
				padding: 0;
				font-size: 1.1rem;
			}
			.contact-list li {
				padding: 0.75rem 0;
				border-top: 1px solid #a9cfe9;
			}
			.contact-list strong {
				display: block;
				font-size: 0.88rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: #0d3f61;
				margin-bottom: 0.2rem;
			}

			.form {
				background: var(--paper);
				border: 1px solid #a9cfe9;
				border-radius: 14px;
				padding: clamp(1.5rem, 3vw, 2.2rem);
			}

			.field {
				margin-bottom: 1.1rem;
			}
			.field label {
				display: block;
				font-size: 1.1rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-soft);
				margin-bottom: 0.5rem;
			}
			.field input,
			.field select,
			.field textarea {
				width: 100%;
				background: var(--paper);
				border: 1px solid var(--line);
				color: var(--text);
				font-family: inherit;
				font-size: 1.12rem;
				padding: 0.85rem 1rem;
			}
			.field textarea {
				resize: vertical;
			}
			.field [aria-invalid='true'] {
				border-color: #b4402d;
			}

			.form-error {
				color: #8f2f1f;
				font-size: 1.12rem;
			}

			.form-note {
				font-size: 1.12rem;
				color: var(--text-soft);
				margin: 0.9rem 0 0;
			}

			/* --- Rodapé --------------------------------------------------------- */
			.foot {
				background: var(--ink-deep);
				color: #a9cfe9;
				font-size: 1.1rem;
				padding: 3rem 0 5.5rem;
			}
			.foot-grid {
				display: grid;
				gap: 2rem;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			}
			.foot-name {
				color: #fff;
				font-weight: 600;
			}
			.foot a {
				color: var(--calm);
			}
			.foot-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1.2rem;
				margin-top: 1.2rem;
			}

			/* --- WhatsApp flutuante ---------------------------------------------- */
			.wa-float {
				position: fixed;
				right: 1.5rem;
				bottom: 1.5rem;
				z-index: 45;
				display: grid;
				place-items: center;
				width: 60px;
				height: 60px;
				border-radius: 50%;
				background: #25d366;
				color: #fff;
				box-shadow: 0 6px 20px rgba(var(--ink-deep-rgb), 0.35);
				transition: background-color 0.2s ease, transform 0.2s ease;
			}
			/* Onda em um ::before atrás do botão: o pulso não deforma o ícone
			   nem atrapalha o hover. */
			.wa-float::before {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: inherit;
				background: #25d366;
				z-index: -1;
				animation: wa-pulse 2.2s ease-out infinite;
			}
			@keyframes wa-pulse {
				0% {
					transform: scale(1);
					opacity: 0.55;
				}
				70%,
				100% {
					transform: scale(1.4);
					opacity: 0;
				}
			}
			.wa-float:hover {
				background: #1ebe5a;
				transform: scale(1.06);
			}
			@media (prefers-reduced-motion: reduce) {
				.wa-float::before {
					animation: none;
				}
			}

			/* --- CTA fixo (mobile) ---------------------------------------------- */
			.sticky-cta {
				display: none;
			}

			@media (max-width: 860px) {
				.lawyer {
					grid-template-columns: 1fr;
				}
				/* Quatro colunas não cabem no celular: viram duas. */
				.steps {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.hero-inner {
					max-width: none;
				}
				/* Sem espaço lateral para a foto: o degradê fecha na vertical. */
				.hero::after {
					background: linear-gradient(
						180deg,
						rgba(20, 20, 20, 0.9) 0%,
						rgba(20, 20, 20, 0.82) 45%,
						rgba(20, 20, 20, 0.95) 100%
					);
				}
				.hero-bg {
					width: 100%;
					transform: none;
					object-position: 30% 40%;
				}
				.wa-float {
					width: 54px;
					height: 54px;
					right: 1rem;
					bottom: 5.25rem;
				}
				.row-item {
					grid-template-columns: 2.5rem minmax(0, 1fr);
					gap: 1rem;
				}
				.sticky-cta {
					position: fixed;
					inset: auto 0 0 0;
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: 1px;
					background: var(--ink-deep);
					padding: 0.6rem;
					z-index: 40;
					box-shadow: 0 -6px 24px #00000040;
				}
				.sticky-cta .btn {
					padding: 0.9rem 0.5rem;
					text-align: center;
					font-size: 1.12rem;
				}
				.sticky-cta .btn-ghost {
					color: #fff;
				}
			}

			/* 390px de largura: título, telefone e CTA precisam caber sem rolagem. */
			@media (max-width: 480px) {
				.steps {
					grid-template-columns: minmax(0, 1fr);
				}
				.hero {
					padding: 2.25rem 0 2.75rem;
				}
				.eyebrow {
					margin-bottom: 1rem;
				}
				.hero h1 {
					font-size: clamp(1.75rem, 7.5vw, 2.15rem);
				}
				.lead {
					font-size: 1.12rem;
					margin-top: 1.1rem;
				}
				.cta-row {
					margin-top: 1.5rem;
					gap: 0.6rem;
				}
				.cta-strip-actions {
					width: 100%;
				}
				.cta-strip-actions .btn {
					flex: 1 1 100%;
					text-align: center;
				}
				.cta-row .btn {
					flex: 1 1 auto;
					text-align: center;
					padding: 0.95rem 1rem;
				}
				.hero-note {
					margin-top: 1rem;
					font-size: 0.92rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
				* {
					transition: none !important;
				}
			}
		</style>
	</body>
</html>

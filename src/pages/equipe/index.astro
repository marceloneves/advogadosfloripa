---
import Layout from '../../layouts/Layout.astro';
import TeamGrid from '../../components/TeamGrid.astro';
import ConsultationCta from '../../components/ConsultationCta.astro';
---

<Layout
	title="Advogados — KFS Sociedade de Advogados"
	description="Conheça os advogados do escritório KFS: formação, áreas de atuação e trajetória profissional."
	heading="Nossos Advogados"
	crumbs={[{ label: 'Advogados' }]}
>
	<section class="team-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">Advogados associados</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Profissionais dedicados ao seu caso</h2>
			</div>
			<TeamGrid variant="style1" />
		</div>
	</section>

	<ConsultationCta />
</Layout>

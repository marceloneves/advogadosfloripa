---
import Layout from '../layouts/Layout.astro';
import ConsultationCta from '../components/ConsultationCta.astro';
import ContactSection from '../components/ContactSection.astro';
import { services, waLink } from '../data/site';
---

<Layout
	title="Áreas de Atuação — KFS Sociedade de Advogados"
	description="Direito Criminal, Militar, da Saúde, Previdenciário, Administrativo e Civil. Conheça as áreas de atuação do escritório KFS em Florianópolis."
	heading="Áreas de Atuação"
	crumbs={[{ label: 'Serviços' }]}
>
	<section class="service-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title wow fadeInUp">O que fazemos</span>
				<h2 class="wow fadeInUp" data-wow-delay=".3s">Soluções jurídicas para o seu caso</h2>
			</div>

			<div class="row g-4">
				{services.map((s, i) => (
					<div class="col-lg-6" id={s.slug}>
						<div class="service-main-items h-100">
							<div class="service-card img-custom-anim-left wow h-100" data-wow-delay=".3s">
								<div class="icon">
									<i class={s.icon}></i>
								</div>
								<div class="content">
									<h4>{s.title}</h4>
									<p>{s.summary}</p>
									<ul class="about-list mt-3">
										{s.bullets.map((b) => (
											<li>
												<i class="fa-solid fa-check"></i>
												{b}
											</li>
										))}
									</ul>
									<div class="mt-4">
										<a
											href={waLink(`Olá! Gostaria de falar sobre ${s.title}.`)}
											target="_blank"
											rel="noopener"
											class="theme-btn"
										>
											Consultar sobre {s.title}
											<i class="fa-solid fa-arrow-right"></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<ConsultationCta
		sub="Não encontrou sua demanda?"
		title="Fale conosco mesmo assim"
		text="Muitos casos cruzam mais de uma área do direito. Descreva a sua situação e indicamos o caminho — ou encaminhamos para quem possa ajudar."
	/>

	<ContactSection formId="servicos-contact" />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ConsultationCta from '../components/ConsultationCta.astro';
import ContactSection from '../components/ContactSection.astro';
import { services } from '../data/site';
---

<Layout
	title="Áreas de Atuação | KFS Advogados Florianópolis"
	description="Direito Criminal, Civil, Militar, Saúde, Trabalho, Previdenciário e Administrativo. Advogados em Florianópolis/SC."
	heading="Áreas de Atuação"
	crumbs={[{ label: 'Serviços' }]}
	animate={false}
>
	<section class="service-section section-padding fix">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="sub-title">O que fazemos</span>
				<h2>Soluções jurídicas para o seu caso</h2>
				<p class="mt-3 kfs-lead">
					Atendimento em Florianópolis e região, presencial no Centro ou por videoconferência.
					Escolha a demanda mais próxima da sua situação.
				</p>
			</div>

			{services.map((area, i) => (
				<div class="kfs-area" id={area.slug}>
					<div class="row g-4">
						<div class="col-lg-4">
							<div class="kfs-area-head">
								<span class="kfs-area-num">{String(i + 1).padStart(2, '0')}</span>
								<div class="kfs-area-icon">
									<i class={area.icon}></i>
								</div>
								<h3>{area.title}</h3>
								<p>{area.summary}</p>
							</div>
						</div>

						<div class="col-lg-8">
							<div class="row g-3">
								{area.topics?.map((t) => (
									<div class="col-md-6">
										<a href={`/servicos/${t.slug}`} class="kfs-service-card">
											<h4>{t.title}</h4>
											<p>{t.text}</p>
											<span class="kfs-service-more">
												Saiba mais
												<i class="fa-solid fa-arrow-right-long"></i>
											</span>
										</a>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			))}
		</div>
	</section>

	<ConsultationCta title="Não encontrou sua demanda? Fale conosco mesmo assim" />

	<ContactSection formId="servicos-contact" />
</Layout>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import SearchPopup from '../components/SearchPopup.astro';
import OffcanvasSidebar from '../components/OffcanvasSidebar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Schema from '../components/Schema.astro';
import { site } from '../data/site';
import { assetVer } from '../data/assets';

interface Props {
  title?: string;
  description?: string;
  /** Page title shown in the breadcrumb hero. Omit on the homepage. */
  heading?: string;
  crumbs?: { label: string; href?: string }[];
  /** Set to false to render the breadcrumb hero without reveal animations. */
  animate?: boolean;
  /** Blocos JSON-LD específicos da página (Service, Person, FAQPage…). */
  schema?: Record<string, unknown>[];
  /** Carrega o Swiper. Só a página que tem carrossel precisa dos ~250 KB. */
  swiper?: boolean;
  /** Imagem de compartilhamento específica da página. */
  ogImage?: string;
  /** Mantém a página fora do índice — usar em páginas ainda sem conteúdo. */
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = 'Escritório de advocacia em Florianópolis. Atuação em Direito Criminal, Civil, Militar, da Saúde, do Trabalho, Previdenciário e Administrativo.',
  heading,
  crumbs = [],
  animate = true,
  schema = [],
  swiper = false,
  ogImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kfsadvogados.com.br');
const ogUrl = new URL(ogImage ?? '/og.png', Astro.site ?? 'https://kfsadvogados.com.br');

/**
 * Com `animate={false}`, o conteúdo da página é renderizado e as classes de
 * animação são retiradas do HTML. Precisa ser no HTML mesmo, e não só no CSS:
 * o WOW.js aplica `visibility:hidden` inline nos `.wow` antes de animar, então
 * desligar só a animação deixaria o conteúdo invisível. Breadcrumb e Footer
 * recebem `animate` por prop; o resto passa por aqui porque a página monta
 * dezenas de componentes de tema.
 */
const ANIM_CLASS = /^(wow|animated|fadeIn\w*|fadeOut\w*|img-custom-anim-\w+)$/;

/** Trechos entre <!--keep-anim--> e <!--/keep-anim--> ficam intactos. */
const KEEP = /<!--keep-anim-->[\s\S]*?<!--\/keep-anim-->/g;

const stripOne = (html: string) =>
  html
    .replace(/\sdata-wow-[\w-]+="[^"]*"/g, '')
    .replace(/class="([^"]*)"/g, (match, cls: string) => {
      const kept = cls.split(/\s+/).filter((c) => c && !ANIM_CLASS.test(c));
      return kept.length ? `class="${kept.join(' ')}"` : '';
    });

const stripAnimations = (html: string) => {
  const preserved: string[] = [];
  // Token improvável de aparecer no conteúdo: um número solto quebraria em
  // textos como "das 9 às 18".
  const masked = html.replace(KEEP, (block) => `@@keep-${preserved.push(block) - 1}@@`);
  return stripOne(masked).replace(/@@keep-(\d+)@@/g, (_, i) => preserved[Number(i)]);
};

const slotHtml = animate ? null : stripAnimations(await Astro.slots.render('default'));
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="author" content={site.legalName} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:image" content={ogUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#2e3754" />

		<!-- A foto de topo (hero na home, breadcrumb nas internas) é background-image
		     no CSS: o navegador só descobre a URL depois de baixar e aplicar as
		     folhas, o que o PageSpeed media como ~1,6s de atraso na LCP. O preload
		     por media query antecipa a busca e baixa uma variante só. As larguras
		     acompanham os breakpoints de .kfs-hero/.breadcrumb-wrapper em site.css. -->
		<link
			rel="preload"
			as="image"
			href="/theme/img/hero-escritorio-1280.webp"
			media="(max-width: 767px)"
			fetchpriority="high"
		/>
		<link
			rel="preload"
			as="image"
			href="/theme/img/hero-escritorio-1920.webp"
			media="(min-width: 768px) and (max-width: 1920px)"
			fetchpriority="high"
		/>
		<link
			rel="preload"
			as="image"
			href="/theme/img/hero-escritorio-2560.webp"
			media="(min-width: 1921px)"
			fetchpriority="high"
		/>

		<!-- Manrope é a tipografia institucional da marca (Manual da Marca KFS),
		     hospedada aqui mesmo (theme/css/manrope.css) em vez de vir do Google
		     Fonts: o <link> de terceiros era render-blocking e cobrava DNS + TLS
		     antes de o download da fonte começar. -->
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href={`/theme/webfonts/manrope-latin.woff2?v=${assetVer}`}
			crossorigin
		/>

		<!-- Folha única gerada por scripts/build-css.mjs a partir das folhas do
		     tema mais manrope.css, fa-subset.css e site.css. Cada <link> extra é
		     um round-trip antes do primeiro paint; edite a folha de origem e rode
		     `npm run build`. O Swiper fica de fora porque só uma página o usa. -->
		<link rel="stylesheet" href={`/theme/css/kfs.css?v=${assetVer}`} />
		{swiper && <link rel="stylesheet" href={`/theme/css/swiper-bundle.min.css?v=${assetVer}`} />}

		<title>{title}</title>

		<Schema crumbs={crumbs} extra={schema} />
	</head>

	<body>
		{/* Primeiro elemento focável: quem navega por teclado pula o menu. */}
		<a href="#conteudo" class="kfs-skip-link">Pular para o conteúdo</a>

		<Preloader />
		<SearchPopup />
		<OffcanvasSidebar />
		<div class="offcanvas__overlay"></div>

		<header id="masthead" class="site-header">
			<Header />
		</header>

		{heading && <Breadcrumb heading={heading} crumbs={crumbs} animate={animate} />}

		<main id="conteudo" tabindex="-1">
			{slotHtml === null ? <slot /> : <Fragment set:html={slotHtml} />}
		</main>

		<Footer animate={animate} />
		<WhatsAppFloat />

		<script is:inline src={`/theme/js/jquery-3.7.1.min.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/bootstrap.bundle.min.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/jquery.nice-select.min.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/viewport.jquery.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/jquery.waypoints.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/jquery.counterup.min.js?v=${assetVer}`}></script>
		{swiper && <script is:inline src={`/theme/js/swiper-bundle.min.js?v=${assetVer}`}></script>}
		<script is:inline src={`/theme/js/jquery.meanmenu.min.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/wow.min.js?v=${assetVer}`}></script>
		<script is:inline src={`/theme/js/main.js?v=${assetVer}`}></script>
	</body>
</html>
